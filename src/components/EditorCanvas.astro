---
import { ORIGINAL_PRESET, GENRES, getFeaturedPresets, getOverlayBackground, getPresetsByGenre } from '../lib/presets';

const featuredPresets = [ORIGINAL_PRESET, ...getFeaturedPresets()];
const featuredIds = new Set(featuredPresets.map((preset) => preset.id));
const remainingByGenre = GENRES.map((genre) => ({
	genre,
	presets: getPresetsByGenre(genre).filter((preset) => !featuredIds.has(preset.id)),
})).filter((group) => group.presets.length > 0);
---

<section
	id="editor"
	class="grid min-h-[calc(100vh-3.5rem)] grid-cols-1 lg:h-[calc(100vh-3.5rem)] lg:grid-cols-[1fr_320px] lg:overflow-hidden"
>
	<div class="flex items-center justify-center overflow-hidden bg-zinc-950 p-4 sm:p-10">
		<div id="preview-wrap" class="flex max-h-full w-full max-w-full flex-col items-center justify-center gap-4 transition-opacity duration-200">
			<canvas
				id="canvas"
				class="max-h-[75vh] max-w-full rounded-sm shadow-[0_1px_1px_rgba(0,0,0,0.2),0_8px_24px_-8px_rgba(0,0,0,0.5)]"
			></canvas>
			<label
				id="editor-dropzone"
				for="editor-file-input"
				class="hidden w-full max-w-3xl cursor-pointer flex-col items-center justify-center rounded-xl border border-dashed border-hairline-strong bg-canvas-soft px-6 py-24 text-center transition-colors hover:border-zinc-500 hover:bg-canvas-soft-2"
			>
				<svg
					width="36"
					height="36"
					viewBox="0 0 24 24"
					fill="none"
					xmlns="http://www.w3.org/2000/svg"
					class="mb-5 text-mute"
				>
					<path
						d="M12 16V4M12 4L7 9M12 4L17 9"
						stroke="currentColor"
						stroke-width="1.6"
						stroke-linecap="round"
						stroke-linejoin="round"
					></path>
					<path
						d="M4 16V18C4 19.1046 4.89543 20 6 20H18C19.1046 20 20 19.1046 20 18V16"
						stroke="currentColor"
						stroke-width="1.6"
						stroke-linecap="round"
						stroke-linejoin="round"
					></path>
				</svg>
				<span class="font-sans text-base font-medium text-ink">Drop an image, paste, or click to browse</span>
				<span class="mt-2 font-mono text-sm text-mute">JPG, PNG, WEBP, or camera RAW</span>
				<input
					id="editor-file-input"
					type="file"
					accept="image/png,image/jpeg,image/webp,.cr3,.cr2,.nef,.nrw,.arw,.raf,.rw2,.orf,.dng,.pef"
					class="sr-only"
				/>
			</label>
			<p id="editor-dropzone-error" class="hidden font-mono text-xs text-error" role="alert"></p>
		</div>
	</div>

	<aside
		class="flex flex-col gap-6 overflow-y-auto border-t border-hairline bg-canvas-soft p-5 lg:border-t-0 lg:border-l"
	>
		<div>
			<h2 class="mb-3 font-mono text-[11px] font-medium tracking-wide text-mute uppercase">
				Preset
			</h2>
			<div id="preset-grid" class="grid grid-cols-2 gap-2">
				{
					featuredPresets.map((preset) => (
						<button
							type="button"
							data-preset-id={preset.id}
							class="preset-card group flex flex-col items-start gap-2 rounded-md border border-hairline bg-canvas p-2.5 text-left transition-colors hover:border-hairline-strong data-[active=true]:border-ink data-[active=true]:ring-1 data-[active=true]:ring-ink"
						>
							{preset.id === 'original' ? (
								<span
									class="h-8 w-full rounded-sm"
									style="background: repeating-linear-gradient(45deg, var(--color-zinc-800), var(--color-zinc-800) 4px, var(--color-zinc-700) 4px, var(--color-zinc-700) 8px);"
								/>
							) : (
								<span class="relative block h-8 w-full overflow-hidden rounded-sm">
									<img
										loading="lazy"
										decoding="async"
										alt={preset.name}
										src={preset.image}
										style={`filter: ${preset.filter};`}
										class="absolute inset-0 h-full w-full object-cover"
									/>
									<span
										class="absolute inset-0"
										style={`background: ${getOverlayBackground(preset.overlay)}; opacity: ${preset.overlay.opacity}; mix-blend-mode: ${preset.overlay.blend};`}
									/>
								</span>
							)}
							<span class="font-sans text-xs font-medium text-ink">{preset.name}</span>
							<span class="font-mono text-[10px] leading-tight text-mute">{preset.tagline}</span>
						</button>
					))
				}
			</div>
			<select
				id="preset-dropdown"
				aria-label="Browse all presets"
				class="mt-3 w-full rounded-md border border-hairline bg-canvas px-2.5 py-2 font-mono text-[11px] text-mute transition-colors hover:border-hairline-strong hover:text-ink focus:border-hairline-strong focus:outline-none"
			>
				<option value="" selected>Browse all 60 presets &rarr;</option>
				{
					remainingByGenre.map(({ genre, presets }) => (
						<optgroup label={genre}>
							{presets.map((preset) => (
								<option value={preset.id}>{preset.name}</option>
							))}
						</optgroup>
					))
				}
			</select>
		</div>

		<div class="flex flex-col gap-4 border-t border-hairline pt-5">
			<div class="flex items-center justify-between">
				<h2 class="font-mono text-[11px] font-medium tracking-wide text-mute uppercase">
					Adjust
				</h2>
				<button
					id="reset-adjustments"
					type="button"
					class="font-mono text-[11px] text-mute transition-colors hover:text-ink"
				>
					Reset
				</button>
			</div>

			<label class="flex flex-col gap-2">
				<span class="flex items-center justify-between font-sans text-sm text-body">
					Grain
					<span id="grain-value" class="font-mono text-xs text-mute">0</span>
				</span>
				<input id="grain-slider" type="range" min="0" max="100" step="1" value="0" />
			</label>

			<label class="flex flex-col gap-2">
				<span class="flex items-center justify-between font-sans text-sm text-body">
					Vignette
					<span id="vignette-value" class="font-mono text-xs text-mute">0</span>
				</span>
				<input id="vignette-slider" type="range" min="0" max="100" step="1" value="0" />
			</label>

			<label class="flex flex-col gap-2">
				<span class="flex items-center justify-between font-sans text-sm text-body">
					Glow / Halation
					<span id="glow-value" class="font-mono text-xs text-mute">0</span>
				</span>
				<input id="glow-slider" type="range" min="0" max="100" step="1" value="0" />
			</label>
		</div>

		<div class="flex flex-col gap-3 border-t border-hairline pt-5">
			<h2 class="font-mono text-[11px] font-medium tracking-wide text-mute uppercase">
				Export options
			</h2>

			<button
				id="letterbox-toggle"
				type="button"
				role="switch"
				aria-pressed="false"
				class="toggle-row flex items-center justify-between rounded-md border border-hairline px-3 py-2.5 transition-colors hover:border-hairline-strong"
			>
				<span class="text-left">
					<span class="block font-sans text-sm text-ink">Anamorphic letterbox</span>
					<span class="block font-mono text-[10px] text-mute">2.39:1 bars</span>
				</span>
				<span class="toggle-track relative h-5 w-9 shrink-0 rounded-full bg-hairline-strong transition-colors">
					<span class="toggle-thumb absolute top-0.5 left-0.5 h-4 w-4 rounded-full bg-zinc-100 transition-transform"></span>
				</span>
			</button>

			<button
				id="metadata-toggle"
				type="button"
				role="switch"
				aria-pressed="false"
				class="toggle-row flex items-center justify-between rounded-md border border-hairline px-3 py-2.5 transition-colors hover:border-hairline-strong"
			>
				<span class="text-left">
					<span class="block font-sans text-sm text-ink">Film stock stamp</span>
					<span class="block font-mono text-[10px] text-mute">corner metadata text</span>
				</span>
				<span class="toggle-track relative h-5 w-9 shrink-0 rounded-full bg-hairline-strong transition-colors">
					<span class="toggle-thumb absolute top-0.5 left-0.5 h-4 w-4 rounded-full bg-zinc-100 transition-transform"></span>
				</span>
			</button>
		</div>
	</aside>
</section>

<style>
	[data-active='true'].preset-card {
		background-color: var(--color-canvas-soft-2);
	}

	[aria-pressed='true'].toggle-row .toggle-track {
		background-color: var(--color-ink);
	}

	[aria-pressed='true'].toggle-row .toggle-thumb {
		background-color: var(--color-canvas);
		transform: translateX(16px);
	}
</style>
