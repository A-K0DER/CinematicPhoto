---
interface Props {
	variant?: 'landing' | 'editor';
	/** Only used when variant is 'editor' — labels the nav action buttons for photo vs. video editing. */
	editorMode?: 'photo' | 'video';
}

const { variant = 'landing', editorMode = 'photo' } = Astro.props;
---

<header
	class="sticky top-0 z-40 flex h-14 items-center justify-between border-b border-hairline bg-canvas/80 px-4 backdrop-blur-md sm:px-6"
>
	<div class="flex items-center gap-6">
		<a href="/" class="flex items-center gap-2" aria-label="Cinematic Photo home">
			<img src="/logo.png" width="20" height="20" alt="" class="h-5 w-5" />
			<span class="font-sans text-[15px] font-semibold tracking-[-0.02em] text-ink"
				>Cinematic Photo</span
			>
		</a>

		{
			variant !== 'editor' && (
				<nav aria-label="Primary" class="hidden items-center gap-5 sm:flex">
					<details class="nav-dropdown relative">
						<summary class="cursor-pointer list-none font-mono text-xs text-body transition-colors hover:text-ink [&::-webkit-details-marker]:hidden">
							Popular Presets
						</summary>
						<div class="absolute left-0 top-full z-50 mt-2 w-56 rounded-md border border-hairline bg-canvas p-1.5 shadow-lg">
							<a href="/presets/the-dark-knight/" class="block rounded-sm px-3 py-2 font-sans text-sm text-body transition-colors hover:bg-canvas-soft hover:text-ink">
								The Dark Knight
							</a>
							<a href="/presets/blade-runner-2049/" class="block rounded-sm px-3 py-2 font-sans text-sm text-body transition-colors hover:bg-canvas-soft hover:text-ink">
								Blade Runner 2049
							</a>
							<a href="/presets/dune/" class="block rounded-sm px-3 py-2 font-sans text-sm text-body transition-colors hover:bg-canvas-soft hover:text-ink">
								Dune
							</a>
							<a href="/presets/interstellar/" class="block rounded-sm px-3 py-2 font-sans text-sm text-body transition-colors hover:bg-canvas-soft hover:text-ink">
								Interstellar
							</a>
							<a href="/presets/the-matrix/" class="block rounded-sm px-3 py-2 font-sans text-sm text-body transition-colors hover:bg-canvas-soft hover:text-ink">
								The Matrix
							</a>
							<a href="/presets/breaking-bad/" class="block rounded-sm px-3 py-2 font-sans text-sm text-body transition-colors hover:bg-canvas-soft hover:text-ink">
								Breaking Bad
							</a>
							<a href="/presets/stranger-things/" class="block rounded-sm px-3 py-2 font-sans text-sm text-body transition-colors hover:bg-canvas-soft hover:text-ink">
								Stranger Things
							</a>
							<a href="/presets/game-of-thrones/" class="block rounded-sm px-3 py-2 font-sans text-sm text-body transition-colors hover:bg-canvas-soft hover:text-ink">
								Game of Thrones
							</a>
						</div>
					</details>
					<a href="/guides/how-to-make-photos-look-cinematic/" class="font-mono text-xs text-body transition-colors hover:text-ink">
						Guides
					</a>
					<details class="nav-dropdown relative">
						<summary class="cursor-pointer list-none font-mono text-xs text-body transition-colors hover:text-ink [&::-webkit-details-marker]:hidden">
							Safe Zones
						</summary>
						<div class="absolute left-0 top-full z-50 mt-2 w-56 rounded-md border border-hairline bg-canvas p-1.5 shadow-lg">
							<a href="/tiktok-safe-zone/" class="block rounded-sm px-3 py-2 font-sans text-sm text-body transition-colors hover:bg-canvas-soft hover:text-ink">
								TikTok
							</a>
							<a href="/instagram-reels-safe-zone/" class="block rounded-sm px-3 py-2 font-sans text-sm text-body transition-colors hover:bg-canvas-soft hover:text-ink">
								Instagram Reels
							</a>
							<a href="/tools/safe-zones/" class="block rounded-sm px-3 py-2 font-sans text-sm text-body transition-colors hover:bg-canvas-soft hover:text-ink">
								Compare both
							</a>
						</div>
					</details>
					<a href="/video-editor/" class="hidden font-mono text-xs text-body transition-colors hover:text-ink">
						Video
					</a>
				</nav>
			)
		}
	</div>

	<div class="flex items-center gap-2">
		{
			variant === 'landing' && (
				<span class="hidden font-mono text-xs text-mute sm:inline-block">
					no uploads &middot; processed on-device
				</span>
			)
		}

		{
			variant === 'editor' && (
				<>
					<button
						id="nav-remove"
						type="button"
						class="rounded-md border border-hairline px-3 py-1.5 font-sans text-sm font-medium text-body transition-colors hover:border-hairline-strong hover:text-ink"
					>
						{editorMode === 'video' ? 'Remove video' : 'Remove image'}
					</button>
					<button
						id="nav-reset"
						type="button"
						class="rounded-md border border-hairline px-3 py-1.5 font-sans text-sm font-medium text-body transition-colors hover:border-hairline-strong hover:text-ink"
					>
						{editorMode === 'video' ? 'New video' : 'New image'}
					</button>
					<button
						id="nav-export"
						type="button"
						class="rounded-md bg-primary px-3 py-1.5 font-sans text-sm font-medium text-on-primary transition-opacity hover:opacity-90"
					>
						{editorMode === 'video' ? 'Download' : 'Export'}
					</button>
				</>
			)
		}

		<button
			id="theme-toggle"
			type="button"
			aria-label="Switch theme"
			class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-hairline text-mute transition-colors hover:border-hairline-strong hover:text-ink"
		>
			<svg
				id="theme-icon-sun"
				width="16"
				height="16"
				viewBox="0 0 24 24"
				fill="none"
				xmlns="http://www.w3.org/2000/svg"
			>
				<circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6" />
				<path
					d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
					stroke="currentColor"
					stroke-width="1.6"
					stroke-linecap="round"
				/>
			</svg>
			<svg
				id="theme-icon-moon"
				width="16"
				height="16"
				viewBox="0 0 24 24"
				fill="none"
				xmlns="http://www.w3.org/2000/svg"
			>
				<path
					d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
					stroke="currentColor"
					stroke-width="1.6"
					stroke-linecap="round"
					stroke-linejoin="round"
				/>
			</svg>
		</button>
	</div>
</header>

<script>
	const themeToggle = document.getElementById('theme-toggle') as HTMLButtonElement;
	const themeColorMeta = document.getElementById('theme-color-meta') as HTMLMetaElement;

	const DARK_THEME_COLOR = '#09090b';
	const LIGHT_THEME_COLOR = '#ffffff';

	function applyThemeColor(theme: string) {
		themeColorMeta.content = theme === 'light' ? LIGHT_THEME_COLOR : DARK_THEME_COLOR;
	}

	applyThemeColor(document.documentElement.dataset.theme ?? 'dark');

	themeToggle.addEventListener('click', () => {
		const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
		document.documentElement.dataset.theme = next;
		localStorage.setItem('theme', next);
		applyThemeColor(next);
	});

	const navDropdowns = document.querySelectorAll<HTMLDetailsElement>('.nav-dropdown');
	document.addEventListener('click', (e) => {
		for (const details of navDropdowns) {
			if (details.open && !details.contains(e.target as Node)) details.open = false;
		}
	});
</script>

<style>
	:root[data-theme='light'] #theme-icon-sun {
		display: none;
	}

	#theme-icon-moon {
		display: none;
	}

	:root[data-theme='light'] #theme-icon-moon {
		display: block;
	}
</style>
