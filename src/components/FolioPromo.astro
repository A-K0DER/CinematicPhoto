---
import { useTranslations } from '../i18n/utils';
import { defaultLocale } from '../i18n/config';

interface Props {
	/** Where the card is shown, sent as utm_content so each placement can be compared. */
	placement: string;
	class?: string;
}

const { placement, class: className = '' } = Astro.props;

const lang = Astro.currentLocale ?? defaultLocale;
const t = useTranslations(lang);
const href = `https://mac-folio.com/?utm_source=cinematicphoto&utm_medium=promo&utm_content=${encodeURIComponent(placement)}`;
---

<!-- Hidden until the script confirms a Mac, so Windows and phone visitors never see it. -->
<aside
	data-folio-promo
	hidden
	class:list={['mx-auto w-full max-w-3xl px-4 py-8 sm:px-6', className]}
>
	<div
		class="flex flex-col gap-5 rounded-lg border border-link/50 bg-gradient-to-br from-link/15 via-canvas-soft to-canvas-soft p-6 text-left shadow-[0_0_40px_-12px] shadow-link/40 sm:flex-row sm:items-center sm:justify-between sm:gap-8"
	>
		<div class="min-w-0">
			<h2 class="font-sans text-xl font-semibold tracking-[-0.02em] text-ink sm:text-2xl">{t('folioPromo.heading')}</h2>
			<p class="mt-2 max-w-xl text-sm leading-6 text-body">{t('folioPromo.body')}</p>
		</div>
		<a
			{href}
			target="_blank"
			rel="noopener"
			class="shrink-0 self-start rounded-md bg-primary px-5 py-2.5 text-center font-sans text-sm font-medium text-on-primary transition-opacity hover:opacity-90 sm:self-center"
		>
			{t('folioPromo.cta')} →
		</a>
	</div>
</aside>

<script>
	// iPadOS reports a Mac platform, but has touch points; Folio is macOS only.
	const isMac = /^Mac/.test(navigator.platform) && navigator.maxTouchPoints < 2;
	if (isMac) {
		document.querySelectorAll<HTMLElement>('[data-folio-promo]').forEach((el) => {
			el.hidden = false;
		});
	}
</script>
