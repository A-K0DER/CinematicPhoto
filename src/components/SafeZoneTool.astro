---
import {
	DEFAULT_SAFE_ZONE_OPACITY,
	SAFE_ZONE_PLATFORMS,
	getSafeZonePlatform,
	getZoneMetric,
	type SafeZonePlatform,
} from '../lib/safeZones';

interface Props {
	/**
	 * - Omitted: free multi-toggle "compare" mode — every comparable (same-ratio) platform can be overlaid together.
	 * - A single id: locks the tool to that platform, no toggle UI. Used by dedicated per-platform landing pages so there's no tab UI to fight for SEO focus.
	 * - An array of ids: locks the toggle set to a single-select segmented control (e.g. Reels / Post / Stories on the Instagram page) — only one active at a time, since they may have different frame ratios.
	 */
	platform?: SafeZonePlatform | SafeZonePlatform[];
}

const { platform } = Astro.props;

const lockedSingle = typeof platform === 'string' ? platform : undefined;
const selectOptions = Array.isArray(platform) ? platform : undefined;
const initialSelectPlatform = selectOptions?.[0];

const defaultOpacityPercent = Math.round(DEFAULT_SAFE_ZONE_OPACITY * 100);
const comparablePlatforms = SAFE_ZONE_PLATFORMS.filter((p) => p.comparable);

// Static breakdown list for locked/multi modes. Select mode renders one panel per option and swaps visibility client-side instead, since only one is active at a time.
const visiblePlatforms = lockedSingle ? SAFE_ZONE_PLATFORMS.filter((p) => p.id === lockedSingle) : comparablePlatforms;

const mode = selectOptions ? 'select' : lockedSingle ? 'locked' : 'multi';
---

<section
	id="safe-zone-tool"
	class="mx-auto flex w-full max-w-3xl flex-col items-center px-4 py-4 sm:px-6"
	data-mode={mode}
	data-locked-platform={lockedSingle ?? ''}
	data-initial-platform={initialSelectPlatform ?? ''}
>
	{
		mode === 'multi' && (
			<div class="flex w-full flex-wrap items-center justify-center gap-2" id="safe-zone-platform-toggles">
				{comparablePlatforms.map((p) => (
					<button
						type="button"
						data-platform={p.id}
						aria-pressed="true"
						data-active="true"
						class="safe-zone-platform-btn group flex items-center gap-2 rounded-full border border-hairline bg-canvas px-3.5 py-1.5 font-mono text-xs text-mute transition-colors hover:border-hairline-strong hover:text-ink data-[active=true]:border-hairline-strong data-[active=true]:text-ink"
					>
						<span
							class="h-2 w-2 rounded-full transition-opacity group-data-[active=false]:opacity-40"
							style={`background:${p.color}`}
						/>
						{p.name}
					</button>
				))}
			</div>
		)
	}

	{
		selectOptions && (
			<div class="flex w-full flex-wrap items-center justify-center gap-2" id="safe-zone-platform-select">
				{selectOptions.map((id, i) => {
					const cfg = getSafeZonePlatform(id);
					return (
						<button
							type="button"
							data-select-platform={id}
							aria-pressed={i === 0 ? 'true' : 'false'}
							data-active={i === 0 ? 'true' : 'false'}
							class="safe-zone-platform-btn group flex items-center gap-2 rounded-full border border-hairline bg-canvas px-3.5 py-1.5 font-mono text-xs text-mute transition-colors hover:border-hairline-strong hover:text-ink data-[active=true]:border-hairline-strong data-[active=true]:text-ink"
						>
							<span
								class="h-2 w-2 rounded-full transition-opacity group-data-[active=false]:opacity-40"
								style={`background:${cfg.color}`}
							/>
							{cfg.name.replace('Instagram ', '')}
						</button>
					);
				})}
			</div>
		)
	}

	<label class="mt-4 flex w-full max-w-[300px] flex-col gap-2">
		<span class="flex items-center justify-between font-mono text-[11px] text-mute">
			Overlay opacity
			<span id="safe-zone-opacity-value">{defaultOpacityPercent}%</span>
		</span>
		<input
			id="safe-zone-opacity-slider"
			type="range"
			min="10"
			max="80"
			step="5"
			value={defaultOpacityPercent}
		/>
	</label>

	<div class="relative mt-6 flex max-w-full items-center justify-center">
		<canvas
			id="safe-zone-canvas"
			class="max-h-[70vh] max-w-full touch-none rounded-xl shadow-[0_1px_1px_rgba(0,0,0,0.2),0_8px_24px_-8px_rgba(0,0,0,0.5)]"
		></canvas>
		<label
			id="safe-zone-dropzone"
			for="safe-zone-file-input"
			class="absolute inset-0 flex cursor-pointer flex-col items-center justify-center gap-2 rounded-xl border border-transparent bg-zinc-950/70 px-6 text-center transition-colors"
		>
			<svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="mb-1 text-zinc-400">
				<path d="M12 16V4M12 4L7 9M12 4L17 9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
				<path d="M4 16V18C4 19.1046 4.89543 20 6 20H18C19.1046 20 20 19.1046 20 18V16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
			<span class="font-sans text-sm font-medium text-zinc-100">Drop a photo, paste, or click</span>
			<span class="font-mono text-[10px] text-zinc-400">JPG, PNG, or WEBP</span>
			<input id="safe-zone-file-input" type="file" accept="image/png,image/jpeg,image/webp" class="sr-only" />
		</label>
	</div>

	<p id="safe-zone-error" class="mt-3 hidden font-mono text-xs text-error" role="alert"></p>
	<p class="mt-3 max-w-[300px] text-center font-mono text-[10px] leading-relaxed text-mute">
		Shows a live preview of the safe-zone frame — the dimmed area is trimmed on save. Drag inside
		the frame to reposition it.
	</p>

	<div class="mt-3 flex w-full max-w-[300px] items-center gap-2">
		<button
			id="safe-zone-recenter"
			type="button"
			class="hidden flex-1 rounded-md border border-hairline px-3 py-2 font-sans text-sm font-medium text-body transition-colors hover:border-hairline-strong hover:text-ink"
		>
			Recenter
		</button>
		<button
			id="safe-zone-remove"
			type="button"
			class="hidden flex-1 rounded-md border border-hairline px-3 py-2 font-sans text-sm font-medium text-body transition-colors hover:border-hairline-strong hover:text-ink"
		>
			Remove image
		</button>
	</div>

	<div class="mt-2 flex w-full max-w-[300px] items-center gap-2">
		<button
			id="safe-zone-new-image"
			type="button"
			class="hidden flex-1 rounded-md border border-hairline px-3 py-2 font-sans text-sm font-medium text-body transition-colors hover:border-hairline-strong hover:text-ink"
		>
			New image
		</button>
		<button
			id="safe-zone-save"
			type="button"
			class="flex-1 rounded-md bg-primary px-3 py-2 font-sans text-sm font-medium text-on-primary transition-opacity hover:opacity-90"
		>
			Save image
		</button>
	</div>
	<div class="mt-2 flex w-full max-w-[300px] items-center gap-2">
		<a
			href="https://checkout.dodopayments.com/buy/pdt_0Nm93aR1Gx0XNF06QTHVI"
			target="_blank"
			rel="noopener noreferrer"
			class="flex-1 rounded-md border border-hairline px-3 py-2 text-center font-sans text-sm font-medium text-body transition-colors hover:border-hairline-strong hover:text-ink"
		>
			Get PNG templates (transparent overlays) →
		</a>
	</div>

	{
		selectOptions ? (
			selectOptions.map((id, i) => {
				const cfg = getSafeZonePlatform(id);
				return (
					<div
						class={`mt-8 grid w-full grid-cols-1 gap-4 ${i === 0 ? '' : 'hidden'}`}
						data-breakdown-platform={id}
					>
						<div class="rounded-md border border-hairline bg-canvas p-3.5">
							<span class="flex items-center gap-2 font-sans text-sm font-medium text-ink">
								<span class="h-2 w-2 rounded-full" style={`background:${cfg.color}`} />
								{cfg.name}
							</span>
							<ul class="mt-2 flex flex-col gap-1">
								{cfg.zones.map((zone) => {
									const metric = getZoneMetric(zone, cfg.frame);
									return (
										<li class="flex items-baseline justify-between gap-3 font-mono text-[11px] leading-relaxed text-mute">
											<span>{zone.label}</span>
											<span class="shrink-0 text-ink">
												{metric.px}px ({metric.percent}%)
											</span>
										</li>
									);
								})}
							</ul>
						</div>
					</div>
				);
			})
		) : (
			<div class={`mt-8 grid w-full grid-cols-1 gap-4 ${visiblePlatforms.length > 1 ? 'sm:grid-cols-2' : ''}`}>
				{visiblePlatforms.map((platform) => (
					<div class="rounded-md border border-hairline bg-canvas p-3.5">
						<span class="flex items-center gap-2 font-sans text-sm font-medium text-ink">
							<span class="h-2 w-2 rounded-full" style={`background:${platform.color}`} />
							{platform.name}
						</span>
						<ul class="mt-2 flex flex-col gap-1">
							{platform.zones.map((zone) => {
								const metric = getZoneMetric(zone, platform.frame);
								return (
									<li class="flex items-baseline justify-between gap-3 font-mono text-[11px] leading-relaxed text-mute">
										<span>{zone.label}</span>
										<span class="shrink-0 text-ink">
											{metric.px}px ({metric.percent}%)
										</span>
									</li>
								);
							})}
						</ul>
					</div>
				))}
			</div>
		)
	}
</section>

<script>
	import {
		SAFE_ZONE_FRAME,
		SAFE_ZONE_PLATFORMS,
		computeSafeZoneCropWindow,
		drawSafeZones,
		getSafeZoneCropPanBounds,
		getSafeZonePlatform,
		type SafeZonePlatform,
	} from '../lib/safeZones';

	const toolSection = document.getElementById('safe-zone-tool') as HTMLElement;
	const mode = toolSection.dataset.mode as 'locked' | 'select' | 'multi';
	const lockedPlatform = (toolSection.dataset.lockedPlatform || '') as SafeZonePlatform | '';
	let activeSelectPlatform = (toolSection.dataset.initialPlatform || '') as SafeZonePlatform | '';

	const dropzone = document.getElementById('safe-zone-dropzone') as HTMLLabelElement;
	const fileInput = document.getElementById('safe-zone-file-input') as HTMLInputElement;
	const canvas = document.getElementById('safe-zone-canvas') as HTMLCanvasElement;
	const errorEl = document.getElementById('safe-zone-error') as HTMLParagraphElement;
	const platformToggles = document.querySelectorAll<HTMLButtonElement>('[data-platform]');
	const selectToggles = document.querySelectorAll<HTMLButtonElement>('[data-select-platform]');
	const breakdownPanels = document.querySelectorAll<HTMLElement>('[data-breakdown-platform]');
	const newImageBtn = document.getElementById('safe-zone-new-image') as HTMLButtonElement;
	const recenterBtn = document.getElementById('safe-zone-recenter') as HTMLButtonElement;
	const removeBtn = document.getElementById('safe-zone-remove') as HTMLButtonElement;
	const saveBtn = document.getElementById('safe-zone-save') as HTMLButtonElement;
	const opacitySlider = document.getElementById('safe-zone-opacity-slider') as HTMLInputElement;
	const opacityValue = document.getElementById('safe-zone-opacity-value') as HTMLSpanElement;

	const ctx = canvas.getContext('2d')!;

	// Preview resolution is capped independently of export — the export always
	// samples the original full-res image, so this only affects on-screen crispness.
	const MAX_PREVIEW_DIMENSION = 1600;

	interface State {
		image: HTMLImageElement | null;
		width: number;
		height: number;
		panX: number;
		panY: number;
	}

	const state: State = { image: null, width: 0, height: 0, panX: 0, panY: 0 };

	function loadImageFromFile(file: Blob): Promise<HTMLImageElement> {
		return new Promise((resolve, reject) => {
			const url = URL.createObjectURL(file);
			const img = new Image();
			img.onload = () => {
				URL.revokeObjectURL(url);
				resolve(img);
			};
			img.onerror = () => {
				URL.revokeObjectURL(url);
				reject(new Error('Could not read this image file.'));
			};
			img.src = url;
		});
	}

	function computePreviewSize(naturalWidth: number, naturalHeight: number) {
		const scale = Math.min(1, MAX_PREVIEW_DIMENSION / Math.max(naturalWidth, naturalHeight));
		return { width: Math.round(naturalWidth * scale), height: Math.round(naturalHeight * scale) };
	}

	function activePlatforms(): SafeZonePlatform[] {
		if (mode === 'locked') return [lockedPlatform as SafeZonePlatform];
		if (mode === 'select') return activeSelectPlatform ? [activeSelectPlatform as SafeZonePlatform] : [];
		return SAFE_ZONE_PLATFORMS.map((p) => p.id).filter(
			(id) => document.querySelector<HTMLButtonElement>(`[data-platform="${id}"]`)?.dataset.active === 'true',
		);
	}

	/** The frame the canvas/export should currently be sized to — varies per active platform in `select` mode since e.g. Post (4:5) isn't 9:16 like Reels/Stories. */
	function currentFrame() {
		if (mode === 'locked') return getSafeZonePlatform(lockedPlatform as SafeZonePlatform).frame;
		if (mode === 'select' && activeSelectPlatform) return getSafeZonePlatform(activeSelectPlatform as SafeZonePlatform).frame;
		return SAFE_ZONE_FRAME;
	}

	function filenamePrefix(): string {
		if (mode === 'locked') return `${lockedPlatform}-safe-zone`;
		if (mode === 'select' && activeSelectPlatform) return `${activeSelectPlatform}-safe-zone`;
		return 'safe-zones';
	}

	function currentOpacity(): number {
		return Number(opacitySlider.value) / 100;
	}

	/**
	 * Draws the full photo at its native (capped) size with a live crop-window
	 * overlay — the area outside the safe-zone frame is dimmed rather than
	 * physically cut away, so dragging to reposition stays visible against the
	 * whole photo. The actual pixel crop only happens in `buildExportCanvas`.
	 */
	function render() {
		const frame = currentFrame();

		if (!state.image) {
			const { width, height } = frame;
			if (canvas.width !== width) canvas.width = width;
			if (canvas.height !== height) canvas.height = height;
			ctx.clearRect(0, 0, width, height);
			ctx.fillStyle = '#09090b';
			ctx.fillRect(0, 0, width, height);
			drawSafeZones(ctx, width, height, activePlatforms(), currentOpacity());
			return;
		}

		const { width, height } = state;
		if (canvas.width !== width) canvas.width = width;
		if (canvas.height !== height) canvas.height = height;

		ctx.clearRect(0, 0, width, height);
		ctx.drawImage(state.image, 0, 0, width, height);

		const crop = computeSafeZoneCropWindow(width, height, frame.width / frame.height, { x: state.panX, y: state.panY });

		// Dim everything outside the crop window.
		ctx.save();
		ctx.fillStyle = 'rgba(0, 0, 0, 0.6)';
		ctx.beginPath();
		ctx.rect(0, 0, width, height);
		ctx.rect(crop.sx, crop.sy, crop.sw, crop.sh);
		ctx.fill('evenodd');
		ctx.restore();

		// Safe-zone overlays, scoped to the crop window so they match the export.
		ctx.save();
		ctx.beginPath();
		ctx.rect(crop.sx, crop.sy, crop.sw, crop.sh);
		ctx.clip();
		ctx.translate(crop.sx, crop.sy);
		drawSafeZones(ctx, crop.sw, crop.sh, activePlatforms(), currentOpacity());
		ctx.restore();

		// Crop window frame.
		ctx.save();
		ctx.strokeStyle = 'rgba(255, 255, 255, 0.9)';
		ctx.lineWidth = Math.max(1.5, Math.min(width, height) * 0.0025);
		ctx.strokeRect(crop.sx, crop.sy, crop.sw, crop.sh);
		ctx.restore();
	}

	function showError(message: string) {
		errorEl.textContent = message;
		errorEl.classList.remove('hidden');
	}

	function clearError() {
		errorEl.classList.add('hidden');
		errorEl.textContent = '';
	}

	async function loadFile(file: File) {
		if (!file.type.startsWith('image/')) {
			showError('That file type is not supported. Try a JPG, PNG, or WEBP.');
			return;
		}
		clearError();
		try {
			const image = await loadImageFromFile(file);
			const { width, height } = computePreviewSize(image.naturalWidth, image.naturalHeight);
			state.image = image;
			state.width = width;
			state.height = height;
			state.panX = 0;
			state.panY = 0;
			dropzone.classList.add('hidden');
			newImageBtn.classList.remove('hidden');
			recenterBtn.classList.remove('hidden');
			removeBtn.classList.remove('hidden');
			canvas.classList.add('cursor-grab');
			render();
		} catch (err) {
			showError(err instanceof Error ? err.message : 'Could not read this image file.');
		}
	}

	function removeImage() {
		state.image = null;
		state.width = 0;
		state.height = 0;
		state.panX = 0;
		state.panY = 0;
		clearError();
		dropzone.classList.remove('hidden');
		newImageBtn.classList.add('hidden');
		recenterBtn.classList.add('hidden');
		removeBtn.classList.add('hidden');
		canvas.classList.remove('cursor-grab');
		render();
	}

	render();

	// --- Upload ---

	fileInput.addEventListener('change', () => {
		const file = fileInput.files?.[0];
		fileInput.value = '';
		if (file) loadFile(file);
	});

	for (const evt of ['dragenter', 'dragover']) {
		dropzone.addEventListener(evt, (e) => {
			e.preventDefault();
			dropzone.classList.add('border-hairline-strong');
		});
	}

	for (const evt of ['dragleave', 'dragend']) {
		dropzone.addEventListener(evt, (e) => {
			e.preventDefault();
			dropzone.classList.remove('border-hairline-strong');
		});
	}

	dropzone.addEventListener('drop', (e) => {
		e.preventDefault();
		dropzone.classList.remove('border-hairline-strong');
		const file = e.dataTransfer?.files?.[0];
		if (file) loadFile(file);
	});

	for (const evt of ['dragover', 'drop']) {
		window.addEventListener(evt, (e) => {
			if ((e.target as HTMLElement)?.closest('#safe-zone-dropzone')) return;
			e.preventDefault();
		});
	}

	window.addEventListener('paste', (e) => {
		const items = e.clipboardData?.items;
		if (!items) return;
		for (const item of items) {
			if (item.type.startsWith('image/')) {
				const file = item.getAsFile();
				if (file) loadFile(file);
				break;
			}
		}
	});

	newImageBtn.addEventListener('click', () => fileInput.click());

	recenterBtn.addEventListener('click', () => {
		state.panX = 0;
		state.panY = 0;
		render();
	});

	removeBtn.addEventListener('click', removeImage);

	// --- Drag to reposition the crop window ---

	interface DragState {
		pointerId: number;
		startClientX: number;
		startClientY: number;
		startPanX: number;
		startPanY: number;
	}

	let drag: DragState | null = null;

	canvas.addEventListener('pointerdown', (e) => {
		if (!state.image) return;
		drag = {
			pointerId: e.pointerId,
			startClientX: e.clientX,
			startClientY: e.clientY,
			startPanX: state.panX,
			startPanY: state.panY,
		};
		canvas.setPointerCapture(e.pointerId);
		canvas.classList.add('cursor-grabbing');
	});

	canvas.addEventListener('pointermove', (e) => {
		if (!drag || drag.pointerId !== e.pointerId) return;
		const rect = canvas.getBoundingClientRect();
		if (rect.width === 0) return;
		// Backing-store pixels per CSS pixel — the canvas is drawn at full
		// preview resolution but displayed scaled down, so mouse deltas need converting.
		const scale = canvas.width / rect.width;
		const dxSource = (e.clientX - drag.startClientX) * scale;
		const dySource = (e.clientY - drag.startClientY) * scale;
		const frame = currentFrame();
		const bounds = getSafeZoneCropPanBounds(state.width, state.height, frame.width / frame.height);
		// Dragging right/down should reveal more of the frame's left/top edge,
		// i.e. slide the crop window the opposite way — so we subtract, not add.
		state.panX = Math.min(Math.max(drag.startPanX - dxSource, -bounds.maxX), bounds.maxX);
		state.panY = Math.min(Math.max(drag.startPanY - dySource, -bounds.maxY), bounds.maxY);
		render();
	});

	function endDrag(e: PointerEvent) {
		if (!drag || drag.pointerId !== e.pointerId) return;
		drag = null;
		canvas.classList.remove('cursor-grabbing');
		if (canvas.hasPointerCapture(e.pointerId)) canvas.releasePointerCapture(e.pointerId);
	}

	canvas.addEventListener('pointerup', endDrag);
	canvas.addEventListener('pointercancel', endDrag);

	// --- Platform toggles (multi mode) ---

	for (const btn of platformToggles) {
		btn.addEventListener('click', () => {
			btn.dataset.active = String(btn.dataset.active !== 'true');
			btn.setAttribute('aria-pressed', btn.dataset.active);
			render();
		});
	}

	// --- Platform select (single-select mode, e.g. Reels / Post / Stories) ---

	for (const btn of selectToggles) {
		btn.addEventListener('click', () => {
			const id = btn.dataset.selectPlatform as SafeZonePlatform;
			if (id === activeSelectPlatform) return;
			activeSelectPlatform = id;

			for (const b of selectToggles) {
				const active = b === btn;
				b.dataset.active = String(active);
				b.setAttribute('aria-pressed', String(active));
			}
			for (const panel of breakdownPanels) {
				panel.classList.toggle('hidden', panel.dataset.breakdownPlatform !== id);
			}

			// The new platform may have a different frame ratio (e.g. switching
			// to Post's 4:5) — reset the pan so the crop window stays centered.
			state.panX = 0;
			state.panY = 0;
			render();
		});
	}

	// --- Opacity ---

	opacitySlider.addEventListener('input', () => {
		opacityValue.textContent = `${opacitySlider.value}%`;
		render();
	});

	// --- Save ---

	function downloadCanvas(source: HTMLCanvasElement, filename: string) {
		source.toBlob((blob) => {
			if (!blob) return;
			const url = URL.createObjectURL(blob);
			const a = document.createElement('a');
			a.href = url;
			a.download = filename;
			document.body.appendChild(a);
			a.click();
			a.remove();
			URL.revokeObjectURL(url);
		}, 'image/png');
	}

	/**
	 * Physically crops the photo to the active safe-zone frame for saving — the
	 * live canvas only shows a preview with the crop dimmed, not cut away.
	 * Samples the original full-resolution image, not the (possibly
	 * downscaled) preview canvas, so export quality isn't capped by it.
	 */
	function buildExportCanvas(): HTMLCanvasElement {
		const { width, height } = currentFrame();
		const output = document.createElement('canvas');
		output.width = width;
		output.height = height;
		const octx = output.getContext('2d')!;
		octx.fillStyle = '#09090b';
		octx.fillRect(0, 0, width, height);

		if (state.image) {
			const previewCrop = computeSafeZoneCropWindow(state.width, state.height, width / height, { x: state.panX, y: state.panY });
			const naturalScale = state.image.naturalWidth / state.width;
			const sx = Math.round(previewCrop.sx * naturalScale);
			const sy = Math.round(previewCrop.sy * naturalScale);
			const sw = Math.round(previewCrop.sw * naturalScale);
			const sh = Math.round(previewCrop.sh * naturalScale);
			octx.drawImage(state.image, sx, sy, sw, sh, 0, 0, width, height);
		}

		drawSafeZones(octx, width, height, activePlatforms(), currentOpacity());
		return output;
	}

	saveBtn.addEventListener('click', () => {
		downloadCanvas(buildExportCanvas(), `${filenamePrefix()}-reference.png`);
	});
</script>
