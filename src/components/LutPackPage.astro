---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import MovieFaq from './MovieFaq.astro';
import { getPreset } from '../lib/presets';
import { lutPackCopy, type LutLocale } from '../data/lutPackCopy';

interface Props {
	locale: LutLocale;
}

const { locale } = Astro.props;
const c = lutPackCopy[locale];

// Dodo Payments product id for the LUT pack (live mode). While empty, the buy buttons render as a disabled "coming soon" state.
const DODO_LUT_PACK_ID = 'pdt_0NphgvBQVEG3XN4CEumS3';
const thankYouUrl = new URL(getRelativeLocaleUrl(locale, '/cinematic-luts/thank-you/'), Astro.url.origin).href;
const checkoutUrl = DODO_LUT_PACK_ID
	? `https://checkout.dodopayments.com/buy/${DODO_LUT_PACK_ID}?redirect_url=${encodeURIComponent(thankYouUrl)}`
	: '';

const path = '/cinematic-luts/';

const luts = [
	{ id: 'dark-knight', file: 'Dark Knight Steel.cube' },
	{ id: 'blade-runner', file: 'Blade Runner Neon.cube' },
	{ id: 'dune', file: 'Dune Desert Gold.cube' },
	{ id: 'matrix', file: 'Matrix Green.cube' },
].map((l) => ({
	...l,
	preset: getPreset(l.id),
	blurb: c.blurbs[l.id as keyof typeof c.blurbs],
}));

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'Product',
	name: c.productName,
	description: c.description,
	url: `https://cinematicphoto.com${getRelativeLocaleUrl(locale, path)}`,
	image: 'https://cinematicphoto.com/og-image.png',
	brand: { '@type': 'Brand', name: 'Cinematic Photo' },
};
---

<Layout title={c.title} description={c.description} keywords={c.keywords} {path} structuredData={structuredData}>
	<Navbar variant="landing" />
	<main>
		<Breadcrumbs
			items={[{ label: c.breadcrumbHome, href: getRelativeLocaleUrl(locale, '/') }, { label: c.breadcrumbCurrent }]}
		/>

		<section class="mx-auto flex w-full max-w-3xl flex-col items-center px-4 pb-4 text-center sm:px-6">
			<span class="mb-4 font-mono text-xs tracking-wide text-mute">{c.eyebrow}</span>
			<h1 class="font-sans text-4xl font-semibold tracking-[-0.03em] text-ink sm:text-5xl">{c.h1}</h1>
			<p class="mt-5 max-w-xl text-base leading-7 text-body">{c.intro}</p>
			{
				checkoutUrl ? (
					<a
						href={checkoutUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="mt-7 inline-block rounded-md bg-primary px-6 py-3 font-sans text-sm font-medium text-on-primary transition-opacity hover:opacity-90"
					>
						{c.buy}
					</a>
				) : (
					<span class="mt-7 inline-block cursor-not-allowed rounded-md border border-hairline px-6 py-3 font-sans text-sm font-medium text-mute">
						{c.comingSoonButton}
					</span>
				)
			}
			<span class="mt-3 font-mono text-xs text-mute">{c.meta}</span>
			<span class="mt-2 font-mono text-xs text-mute">{c.moreSoonLine}</span>
		</section>

		<section class="mx-auto w-full max-w-3xl px-4 py-14 sm:px-6">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">{c.insideEyebrow}</span>
			<h2 class="font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">{c.insideHeading}</h2>
			<div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
				{
					luts.map((l) => (
						<figure class="flex flex-col gap-2">
							<span class="relative block aspect-[4/5] w-full overflow-hidden rounded-md border border-hairline bg-canvas-soft">
								<img
									loading="lazy"
									decoding="async"
									alt={c.imageAlt.replace('{name}', l.preset.name)}
									src={l.preset.image}
									class="absolute inset-0 h-full w-full object-cover"
								/>
							</span>
							<figcaption>
								<span class="block font-sans text-sm font-medium text-ink">{l.preset.name}</span>
								<span class="block font-mono text-xs text-mute">{l.blurb} · {l.file}</span>
							</figcaption>
						</figure>
					))
				}
			</div>
			<p class="mt-4 text-sm leading-6 text-mute">
				{c.previewNote}
				<a href={getRelativeLocaleUrl(locale, '/presets/')} class="text-ink underline underline-offset-2">{c.previewLinkText}</a>.
			</p>
		</section>

		<section class="mx-auto w-full max-w-3xl px-4 pb-14 sm:px-6">
			<div class="rounded-md border border-hairline bg-canvas-soft p-5">
				<span class="block font-mono text-xs tracking-wide text-mute">{c.soonEyebrow}</span>
				<h2 class="mt-2 font-sans text-xl font-semibold tracking-[-0.02em] text-ink">{c.soonHeading}</h2>
				<p class="mt-2 text-base leading-7 text-body">{c.soonBody}</p>
			</div>
		</section>

		<section class="mx-auto w-full max-w-3xl px-4 pb-14 sm:px-6">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">{c.howEyebrow}</span>
			<h2 class="font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">{c.howHeading}</h2>
			<div class="mt-6 overflow-x-auto">
				<table class="w-full min-w-[520px] border-collapse text-left">
					<tbody>
						{
							c.software.map(([name, how]) => (
								<tr class="border-b border-hairline align-top">
									<td class="py-3 pr-4 font-sans text-sm font-medium whitespace-nowrap text-ink">{name}</td>
									<td class="py-3 text-sm leading-6 text-body">{how}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
		</section>

		<section class="mx-auto flex w-full max-w-3xl flex-col items-center px-4 pb-14 text-center sm:px-6">
			<h2 class="font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">{c.closingHeading}</h2>
			<p class="mt-3 max-w-md text-base leading-7 text-body">{c.closingBody}</p>
			{
				checkoutUrl ? (
					<a
						href={checkoutUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="mt-6 inline-block rounded-md bg-primary px-6 py-3 font-sans text-sm font-medium text-on-primary transition-opacity hover:opacity-90"
					>
						{c.buy}
					</a>
				) : (
					<span class="mt-6 inline-block cursor-not-allowed rounded-md border border-hairline px-6 py-3 font-sans text-sm font-medium text-mute">
						{c.comingSoonButton}
					</span>
				)
			}
		</section>

		<MovieFaq eyebrow="FAQ" heading={c.faqHeading} faqs={c.faqs} />
	</main>
	<Footer />
</Layout>
