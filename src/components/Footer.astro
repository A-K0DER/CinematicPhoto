---
import { getRelativeLocaleUrl } from 'astro:i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { useTranslations } from '../i18n/utils';
import { defaultLocale } from '../i18n/config';

const year = new Date().getFullYear();

const lang = Astro.currentLocale ?? defaultLocale;
const t = useTranslations(lang);
const u = (path: string) => getRelativeLocaleUrl(lang, path);
---

<footer class="border-t border-hairline px-4 py-10 sm:px-6">
	<div class="mx-auto flex max-w-3xl flex-col items-center gap-4 text-center">
		<nav aria-label="Footer" class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
			<a
				href={u('/presets')}
				class="font-sans text-sm text-body transition-colors hover:text-ink"
			>
				{t('nav.allPresets')}
			</a>
			<a
				href={u('/guides/how-to-make-photos-look-cinematic/')}
				class="font-sans text-sm text-body transition-colors hover:text-ink"
			>
				{t('nav.guides')}
			</a>
			<a
				href={u('/guides/cinematic-color-grading/')}
				class="font-sans text-sm text-body transition-colors hover:text-ink"
			>
				{t('nav.guideColorGrading')}
			</a>
			<a
				href={u('/guides/social-media-safe-zones/')}
				class="font-sans text-sm text-body transition-colors hover:text-ink"
			>
				{t('footer.safeZoneGuide')}
			</a>
			<a
				href={u('/guides/youtube-thumbnail-design/')}
				class="font-sans text-sm text-body transition-colors hover:text-ink"
			>
				{t('footer.thumbnailGuide')}
			</a>
			<a
				href={u('/for/portraits/')}
				class="font-sans text-sm text-body transition-colors hover:text-ink"
			>
				{t('footer.portraits')}
			</a>
			<a
				href={u('/tiktok-safe-zone/')}
				class="font-sans text-sm text-body transition-colors hover:text-ink"
			>
				{t('footer.tiktokSafeZone')}
			</a>
			<a
				href={u('/tiktok-safe-zone-template/')}
				class="font-sans text-sm text-body transition-colors hover:text-ink"
			>
				{t('nav.tiktokTemplate')}
			</a>
			<a
				href={u('/instagram-reels-safe-zone/')}
				class="font-sans text-sm text-body transition-colors hover:text-ink"
			>
				{t('footer.reelsSafeZone')}
			</a>
			<a
				href={u('/instagram-safe-zone-template/')}
				class="font-sans text-sm text-body transition-colors hover:text-ink"
			>
				{t('nav.instagramTemplate')}
			</a>
			<a
				href={u('/alternatives/')}
				class="font-sans text-sm text-body transition-colors hover:text-ink"
			>
				{t('footer.alternatives')}
			</a>
			<a
				href={u('/faq/')}
				class="font-sans text-sm text-body transition-colors hover:text-ink"
			>
				{t('footer.faq')}
			</a>
			<a
				href={u('/about-us')}
				class="font-sans text-sm text-body transition-colors hover:text-ink"
			>
				{t('footer.aboutUs')}
			</a>
			<a
				href={u('/contact-us')}
				class="font-sans text-sm text-body transition-colors hover:text-ink"
			>
				{t('footer.contactUs')}
			</a>
			<a
				href="/privacy-policy"
				class="font-sans text-sm text-body transition-colors hover:text-ink"
			>
				{t('footer.privacyPolicy')}
			</a>
			<a
				href="/terms-and-conditions"
				class="font-sans text-sm text-body transition-colors hover:text-ink"
			>
				{t('footer.termsAndConditions')}
			</a>
		</nav>
		<LanguageSwitcher />
		<p class="font-mono text-xs text-mute">&copy; {year} Cinematic Photo. {t('footer.allRightsReserved')}</p>
	</div>
</footer>
