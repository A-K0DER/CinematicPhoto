---
const faqs = [
	{
		q: 'Is Cinematic Photo really a free ai photo editor?',
		a: 'Yes. Every preset, slider, and export option is free with no account, watermark, or usage cap. There is no premium tier hiding the good filters — the full cinematic color grading tool is available the moment the page loads.',
	},
	{
		q: 'Do I need to upload my photo to use this online photo editor?',
		a: 'No. Cinematic Photo is a client side photo editor — your image is decoded and rendered on a canvas inside your own browser tab. Nothing is transmitted to a server, so there is no upload wait and no privacy trade-off.',
	},
	{
		q: 'How do I make a photo look like Blade Runner 2049 or Dune?',
		a: 'Drop in an image, then select the Blade Runner 2049 preset for an amber-neon, teal-haze grade, or the Dune preset for a warm desert-gold look. Each preset instantly applies a movie-accurate color curve, and you can fine-tune grain, vignette, and glow afterward.',
	},
	{
		q: 'What image formats and aspect ratios are supported?',
		a: 'JPG, PNG, and WEBP files can be dropped, pasted, or browsed in. For framing, toggle the anamorphic letterbox to crop your image to a 2.39:1 cinematic aspect ratio with black bars, just like a widescreen theatrical frame.',
	},
	{
		q: 'How do I give my photos the moody, desaturated look of Interstellar?',
		a: 'Select the Interstellar preset to apply a cold cosmic blue color curve with deep, desaturated blacks, the same restrained sci-fi grade used throughout the film. Add a touch of grain and vignette afterward to deepen the mood even further.',
	},
	{
		q: 'Can I apply the dusty, warm golden-hour color grade of Dune to my landscape photos?',
		a: "Yes. Select the Dune preset to grade your photo with warm desert-gold tones and gently blown highlights, mimicking the film's sun-bleached, dust-filled cinematography. It's especially effective on landscape and outdoor shots with strong natural light.",
	},
	{
		q: 'How do I add the iconic high-contrast green matrix tint to my portraits?',
		a: "Choose the Matrix preset to apply the film's signature high-gain digital green tint instantly. Since it's a color grade rather than a crop, it works just as well on portraits as full scenes — layer in some grain afterward for an even more degraded-monitor feel.",
	},
	{
		q: 'How do I recreate the gritty, crushed shadows and cold steel look of The Dark Knight?',
		a: "Apply The Dark Knight preset, which crushes shadow detail and shifts tones toward a cold steel blue for the film's gritty, high-contrast urban look. Nudging up the vignette slightly helps draw the eye inward and deepen the edges of the frame.",
	},
	{
		q: 'What is the best way to get the neon amber and teal glow of a cyberpunk movie scene on my urban night photos?',
		a: 'Use the Blade Runner 2049 preset, which grades highlights toward amber neon and shadows toward a teal haze — the classic cyberpunk color split. On night city shots, add glow and halation to bloom light sources the way anamorphic lenses flare around neon signs and streetlights.',
	},
	{
		q: 'How do I make my vacation photos look like a vintage 35mm Hollywood film still?',
		a: 'Start from any preset for your base color grade, then dial in grain for authentic film texture, a touch of vignette to darken the corners, and switch on the film stock stamp for a printed-negative finish. Toggling the anamorphic letterbox on top completes the theatrical, 35mm-still look.',
	},
	{
		q: 'Can I edit my photos to match the pastel, symmetrical aesthetic of a Wes Anderson movie?',
		a: "Cinematic Photo doesn't have a dedicated Wes Anderson preset yet — its current presets are modeled on specific sci-fi and noir-leaning films rather than pastel palettes. For now, the Original grade with light grain and no vignette leaves the most room for a soft, symmetrical edit while we look at adding a preset built specifically for that look.",
	},
	{
		q: 'How do I achieve the high-contrast, moody monochrome noir look from classic detective films?',
		a: "There isn't a black-and-white noir preset built in yet, so a full monochrome conversion isn't currently supported. The closest available options are Interstellar's deep, cool blacks or The Dark Knight's crushed shadows, both of which push contrast and shadow depth in a moody, high-contrast direction.",
	},
	{
		q: 'What color grading settings do I need to make a photo look like a cinematic sci-fi thriller?',
		a: 'Interstellar, Blade Runner 2049, and Matrix are each built around a distinct sci-fi color signature — cold cosmic blue, amber-neon with teal haze, and high-gain green. Pick whichever tone fits your subject, then layer in grain and glow to reinforce the tense, lens-driven atmosphere of a thriller.',
	},
	{
		q: 'How do I replicate the warm, nostalgic, sun-faded film look of a 1970s indie movie?',
		a: "Combine the Dune preset's warm, sun-bleached tones with a moderate amount of grain and vignette to fade the edges and roughen the texture the way an aged 35mm print looks. The film stock stamp adds a final period-accurate touch.",
	},
];

const faqStructuredData = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: {
			'@type': 'Answer',
			text: f.a,
		},
	})),
};
---

<section class="border-t border-hairline bg-canvas-soft px-4 py-20 sm:px-6">
	<div class="mx-auto max-w-3xl">
		<span class="mb-4 block font-mono text-xs tracking-wide text-mute">WHY CINEMATIC PHOTO</span>
		<h2 class="max-w-2xl font-sans text-3xl font-semibold tracking-[-0.03em] text-ink sm:text-4xl">
			A cinematic photo editor built for movie-grade color grading
		</h2>

		<div class="mt-8 flex flex-col gap-6 text-base leading-7 text-body">
			<p>
				Cinematic Photo is a free online photo editor that turns an ordinary picture into a
				movie-style still in one click. Most photo editor apps bury cinematic looks behind
				subscriptions, masking tools, or a steep learning curve. Cinematic Photo works more like a
				colorist's shortcut: pick a preset, nudge a few sliders, export — no tutorial required.
				It's a genuinely easy alternative to Lightroom cinematic presets for anyone who just wants
				the movie aesthetic without installing desktop software or learning curve panels, and a
				faster option than a generic iloveimg photo editor alternative when the look you want is
				specifically cinematic.
			</p>
			<p>
				As a photo editor app, it stays deliberately narrow: instead of trying to be a full
				general-purpose editor with hundreds of unrelated tools, it focuses entirely on one job —
				making a photo look and feel like a frame pulled from a movie. That focus is what makes it
				fast. There's no menu-diving to find the cinematic look; every control on screen exists to
				push a photo closer to a film-grade image, so going from a flat snapshot to a graded still
				takes seconds rather than the many-step workflow a general online photo editor with movie
				filters usually demands.
			</p>

			<h3 class="font-sans text-xl font-semibold tracking-[-0.02em] text-ink">
				Movie-inspired color grading presets
			</h3>
			<p>
				Each preset in this cinematic editor is modeled on a recognizable film look. Apply the
				Blade Runner 2049 photo filter online for amber neon highlights cut with a teal haze —
				the fastest way to make a photo look like Blade Runner 2049 without hand-grading curves.
				Reach for the Dark Knight color grading preset for crushed blacks and a cold steel tone,
				or the classic teal and orange color grade photo generator look for punchy, contrast-rich
				portraits. The Interstellar movie color filter effect delivers cold cosmic blue and deep
				shadow detail, the Dune movie color grading look online brings warm desert gold and
				blown highlights, and the Matrix green tint photo filter recreates the film's signature
				high-gain digital green. Every option applies a cinematic filter to a photo for free,
				instantly, directly on the canvas.
			</p>

			<h3 class="font-sans text-xl font-semibold tracking-[-0.02em] text-ink">
				Film texture and cinematic framing
			</h3>
			<p>
				Beyond color, Cinematic Photo adds the texture and framing details that sell a movie
				look. Add film grain to a photo online for free with a single slider, dial in a
				vignette, or add glow and halation the way anamorphic lenses bloom around bright light
				sources — the closest thing to applying a movie LUT to an image without dedicated
				grading software. Add a cinematic letterbox to a photo online with one toggle to crop to
				a 2.39:1 cinematic aspect ratio, complete with black bars across the top and bottom of
				the frame, and stamp a film-stock label in the corner for an authentic finish.
			</p>

			<h3 class="font-sans text-xl font-semibold tracking-[-0.02em] text-ink">
				Private by design — nothing ever leaves your device
			</h3>
			<p>
				This is a browser based cinematic photo editor with client side photo editor
				architecture from the ground up: no uploads, no accounts, and no server ever sees your
				image. Every filter, grade, and export renders locally on an HTML canvas in your
				browser tab, so a quick movie look photo filter is available even on a slow connection —
				and your photos stay yours.
			</p>

			<h3 class="font-sans text-xl font-semibold tracking-[-0.02em] text-ink">
				Who it's for
			</h3>
			<p>
				Photographers, filmmakers, and social creators use Cinematic Photo as a free online
				photo aesthetic filter tool for thumbnails, posters, and portfolio stills. Think of it
				as an indie film photo effect generator for anyone building a Hollywood style photo
				filter into their workflow — an online movie color grader that turns a flat photo into a
				film-grade image in the time it takes to drag a slider.
			</p>
		</div>

		<div class="mt-16 border-t border-hairline pt-10">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">FAQ</span>
			<div class="flex flex-col divide-y divide-hairline">
				{
					faqs.map((faq) => (
						<details class="group py-5">
							<summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-sans text-base font-semibold text-ink [&::-webkit-details-marker]:hidden">
								<span>{faq.q}</span>
								<svg
									class="h-4 w-4 flex-shrink-0 text-mute transition-transform duration-200 group-open:rotate-180"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<polyline points="6 9 12 15 18 9" />
								</svg>
							</summary>
							<p class="mt-2 text-sm leading-6 text-body">{faq.a}</p>
						</details>
					))
				}
			</div>
		</div>
	</div>

	<script type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
</section>
