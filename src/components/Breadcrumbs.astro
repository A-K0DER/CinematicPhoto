---
interface Crumb {
	label: string;
	href?: string;
}

interface Props {
	items: Crumb[];
}

const { items } = Astro.props;
const siteUrl = 'https://cinematicphoto.com';

const breadcrumbStructuredData = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: items.map((item, index) => ({
		'@type': 'ListItem',
		position: index + 1,
		name: item.label,
		...(item.href ? { item: new URL(item.href, siteUrl).toString() } : {}),
	})),
};
---

<nav aria-label="Breadcrumb" class="mx-auto w-full max-w-5xl px-4 pt-6 sm:px-6">
	<ol class="flex flex-wrap items-center gap-1.5 font-mono text-xs text-mute">
		{
			items.map((item, index) => (
				<li class="flex items-center gap-1.5">
					{index > 0 && <span aria-hidden="true">/</span>}
					{item.href ? (
						<a href={item.href} class="transition-colors hover:text-ink">
							{item.label}
						</a>
					) : (
						<span class="text-ink" aria-current="page">
							{item.label}
						</span>
					)}
				</li>
			))
		}
	</ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbStructuredData)} />
