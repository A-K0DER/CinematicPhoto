---
import { GENRES, getPreset, getPresetsByGenre, getOverlayBackground } from '../lib/presets';

interface Props {
	presetId?: string;
	/** A curated set of presets to feature instead of a single preset or the default genre showcase. */
	presetIds?: string[];
	heading?: string;
	headingTag?: 'h1' | 'h2';
	eyebrow?: string;
	subheading?: string;
	showFooterLinks?: boolean;
	/** Skip the eyebrow/heading/subheading block, e.g. when a page's own hero already covers it. */
	showHeading?: boolean;
	/** Tighter, left-aligned layout with no outer max-width/padding, for placing next to other content. */
	compact?: boolean;
}

const {
	presetId,
	presetIds,
	heading = 'The free cinematic photo editor for movie-grade stills.',
	headingTag = 'h1',
	eyebrow = 'CINEMATIC PHOTO EDITOR',
	subheading = 'Drop a photo to apply iconic Hollywood color grades. Processed entirely in your browser. Nothing is ever uploaded.',
	showFooterLinks = true,
	showHeading = true,
	compact = false,
} = Astro.props;

const showcasePresets = presetId
	? [getPreset(presetId)]
	: presetIds
		? presetIds.map((id) => getPreset(id))
		: GENRES.map((genre) => getPresetsByGenre(genre)[0]);
const defaultPresetId = presetId ?? presetIds?.[0];
const Heading = headingTag;
---

<section
	id="dropzone"
	class={compact
		? 'flex w-full flex-col items-start'
		: 'mx-auto flex w-full max-w-5xl flex-col items-center px-4 py-16'}
	data-default-preset={defaultPresetId}
>
	{
		showHeading && (
			<>
				<span class="mb-4 font-mono text-xs tracking-wide text-mute">{eyebrow}</span>
				<Heading class="max-w-xl text-center font-sans text-4xl font-semibold tracking-[-0.03em] text-ink sm:text-5xl">
					{heading}
				</Heading>
				<p class="mt-4 max-w-md text-center text-base leading-7 text-body">{subheading}</p>
			</>
		)
	}

	<label
		id="dropzone-target"
		for="file-input"
		class={`flex w-full max-w-xl cursor-pointer flex-col items-center justify-center rounded-xl border border-dashed border-hairline-strong bg-canvas-soft px-6 py-16 text-center transition-colors hover:border-zinc-500 hover:bg-canvas-soft-2 ${showHeading ? 'mt-10' : ''}`}
	>
		<svg
			width="28"
			height="28"
			viewBox="0 0 24 24"
			fill="none"
			xmlns="http://www.w3.org/2000/svg"
			class="mb-4 text-mute"
		>
			<path
				d="M12 16V4M12 4L7 9M12 4L17 9"
				stroke="currentColor"
				stroke-width="1.6"
				stroke-linecap="round"
				stroke-linejoin="round"
			></path>
			<path
				d="M4 16V18C4 19.1046 4.89543 20 6 20H18C19.1046 20 20 19.1046 20 18V16"
				stroke="currentColor"
				stroke-width="1.6"
				stroke-linecap="round"
				stroke-linejoin="round"
			></path>
		</svg>
		<span class="font-sans text-sm font-medium text-ink">Drop an image, paste, or click to browse</span>
		<span class="mt-1.5 font-mono text-xs text-mute">JPG, PNG, WEBP, or camera RAW</span>
		<input
			id="file-input"
			type="file"
			accept="image/png,image/jpeg,image/webp,.cr3,.cr2,.nef,.nrw,.arw,.raf,.rw2,.orf,.dng,.pef"
			class="sr-only"
		/>
	</label>

	<p id="dropzone-error" class="mt-4 hidden font-mono text-xs text-error" role="alert"></p>

	<p
		id="pending-preset-label"
		class="mt-4 hidden font-mono text-xs text-ink"
		role="status"
	></p>

	<div class={compact ? 'mt-8 w-full' : 'mt-14 w-full max-w-3xl'}>
		<p class={`mb-4 font-mono text-xs tracking-wide text-mute ${compact ? 'text-left' : 'text-center'}`}>
			{presetId
				? 'PRESET SELECTED · READY TO APPLY'
				: presetIds
					? 'CURATED PRESETS · PICK ONE TO START'
					: '50 MOVIE-INSPIRED GRADES · PICK ONE TO START'}
		</p>
		<div id="preset-showcase" class="grid grid-cols-2 gap-2.5 sm:grid-cols-4">
			{
				showcasePresets.map((preset) => (
					<button
						type="button"
						data-preset-id={preset.id}
						class="showcase-card group flex flex-col items-start gap-2 rounded-md border border-hairline bg-canvas-soft p-2.5 text-left transition-colors hover:border-hairline-strong data-[active=true]:border-ink data-[active=true]:ring-1 data-[active=true]:ring-ink"
					>
						<span class="relative block h-12 w-full overflow-hidden rounded-sm">
							<img
								loading="lazy"
								decoding="async"
								alt={preset.name}
								src={preset.image}
								style={`filter: ${preset.filter};`}
								class="absolute inset-0 h-full w-full object-cover"
							/>
							<span
								class="absolute inset-0"
								style={`background: ${getOverlayBackground(preset.overlay)}; opacity: ${preset.overlay.opacity}; mix-blend-mode: ${preset.overlay.blend};`}
							/>
						</span>
						<span class="font-sans text-xs font-medium text-ink">{preset.name}</span>
						<span class="font-mono text-[10px] text-mute">{preset.genre}</span>
					</button>
				))
			}
		</div>
		<a
			href="/presets/"
			class={`mt-4 block font-mono text-xs text-mute transition-colors hover:text-ink ${compact ? 'text-left' : 'text-center'}`}
		>
			Browse all 50 presets &rarr;
		</a>
	</div>

	{
		showFooterLinks && (
			<nav aria-label="About Cinematic Photo" class="mt-14 flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
				<a href="/about-us" class="font-mono text-xs text-mute transition-colors hover:text-ink">About Us</a>
				<a href="/contact-us" class="font-mono text-xs text-mute transition-colors hover:text-ink">Contact Us</a>
				<a href="/privacy-policy" class="font-mono text-xs text-mute transition-colors hover:text-ink">Privacy Policy</a>
				<a href="/terms-and-conditions" class="font-mono text-xs text-mute transition-colors hover:text-ink">Terms &amp; Conditions</a>
			</nav>
		)
	}
</section>
