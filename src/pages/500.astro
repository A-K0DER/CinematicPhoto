---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const title = 'Something Went Wrong — Cinematic Photo Editor';
const description = 'An unexpected error occurred.';
---

<Layout title={title} description={description} path="/500" noindex>
	<Navbar />
	<main class="mx-auto flex max-w-3xl flex-col items-center px-4 py-32 text-center sm:px-6">
		<span class="mb-4 block font-mono text-xs tracking-wide text-mute">ERROR 500</span>
		<h1 class="font-sans text-3xl font-semibold tracking-[-0.03em] text-ink sm:text-4xl">
			Something went wrong
		</h1>
		<p class="mt-4 max-w-md text-base leading-7 text-body">
			An unexpected error occurred on our end. Try refreshing the page, or head back home and
			try again.
		</p>
		<a
			href="/"
			class="mt-8 rounded-md bg-primary px-4 py-2 font-sans text-sm font-medium text-on-primary transition-opacity hover:opacity-90"
		>
			Back to home
		</a>
	</main>
	<Footer />
</Layout>
