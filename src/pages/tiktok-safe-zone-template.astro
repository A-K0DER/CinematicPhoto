---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import MovieFaq from '../components/MovieFaq.astro';
import { getSafeZonePlatform, getZoneMetric } from '../lib/safeZones';

const path = '/tiktok-safe-zone-template/';
const title = 'TikTok Safe Zone Template (2026) | PNG Guide for CapCut & Premiere Pro';
const description =
	"The 2026 TikTok safe zone template: exact top bar, caption/username/sound, and icon-rail dimensions in pixels and percent, plus how to build a safe zone guide layer in CapCut or Premiere Pro before you export.";
const keywords =
	'tiktok template, tiktok template png, tiktok template app, tiktok safe zone template, tiktok safe zone png, tiktok safe zone overlay, tiktok safe zone 2026, tiktok safe zone template capcut, capcut tiktok safe zone, tiktok safe zone template premiere pro, tiktok safe zones organic, tiktok safe zone dimensions';

const tiktok = getSafeZonePlatform('tiktok');
const [topBar, captionBand, iconRail] = tiktok.zones;
const topMetric = getZoneMetric(topBar, tiktok.frame);
const captionMetric = getZoneMetric(captionBand, tiktok.frame);
const iconMetric = getZoneMetric(iconRail, tiktok.frame);

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: 'TikTok Safe Zone Template (2026): Exact Dimensions for CapCut & Premiere Pro',
	description,
	url: `https://cinematicphoto.com${path}`,
	author: { '@type': 'Organization', name: 'Cinematic Photo' },
	publisher: { '@type': 'Organization', name: 'Cinematic Photo' },
	mainEntityOfPage: `https://cinematicphoto.com${path}`,
};

const howToStructuredData = {
	'@context': 'https://schema.org',
	'@type': 'HowTo',
	name: 'How to add a TikTok safe zone guide in CapCut or Premiere Pro',
	description:
		"Build a TikTok safe zone reference layer in your editor so captions, faces, and logos never end up under TikTok's own UI.",
	step: [
		{
			'@type': 'HowToStep',
			name: 'Generate a reference PNG',
			text: "Drop a frame from your edit into the free TikTok safe zone checker and export the reference PNG showing exactly where TikTok's UI will sit.",
		},
		{
			'@type': 'HowToStep',
			name: 'Add it as an overlay or top track',
			text: "In CapCut, add it via Overlay; in Premiere Pro, place it on a video track above your main footage.",
		},
		{
			'@type': 'HowToStep',
			name: 'Lower the opacity',
			text: 'Drop the layer opacity to around 30-40% so it reads as a guide, not a burned-in graphic, and scale it to fill the full 1080x1920 frame.',
		},
		{
			'@type': 'HowToStep',
			name: 'Hide or delete it before exporting',
			text: 'Toggle the overlay/track off, or delete the layer, once your composition clears the safe zone, so it never renders into the final export.',
		},
	],
};

const faqs = [
	{
		q: 'What is a template on TikTok?',
		a: "On this page, a TikTok template is the exact top bar, caption/username/sound, and icon-rail dimensions TikTok reserves for its own UI, in pixels and percent, packaged so it can be turned into a guide layer in an editor. It's a composition reference, not a design template with pre-built text or graphics, its whole purpose is showing where TikTok's own interface will cover part of the frame, so nothing important gets placed there by accident.",
	},
	{
		q: 'Is there a downloadable TikTok safe zone template PNG?',
		a: "A dedicated transparent-overlay PNG pack is in the works and not live yet. In the meantime, the free interactive checker below already draws the exact safe zone to scale on your own photo or frame grab, and lets you export a reference PNG to use as a placement guide while you edit.",
	},
	{
		q: "Has TikTok's safe zone changed for 2026?",
		a: "The dimensions on this page reflect TikTok's current published creator and ads specs. TikTok periodically nudges its UI (a wider icon rail, a taller caption band), so this template gets rechecked against the live app rather than left static, treat any safe zone template, including this one, as a close approximation rather than a permanent pixel-exact spec.",
	},
	{
		q: 'How do I add a TikTok safe zone template in CapCut?',
		a: "Import the reference PNG, then use CapCut's Overlay feature to place it on top of your main timeline. Scale it to fill the full frame, drop the opacity down so you can still see your footage underneath, and leave it on the top layer while you edit. Delete or hide the overlay clip before your final export so it doesn't render into the video.",
	},
	{
		q: 'How do I add a TikTok safe zone template in Premiere Pro?',
		a: "Import the reference PNG as a clip and place it on a video track above your footage (e.g. V2 sitting over V1). Select the clip, open Effect Controls, and lower its Opacity to around 30-40% so it acts as a guide. Premiere's built-in Safe Margins overlay (the wrench icon on the Program Monitor) shows a generic action/title-safe guide, but it isn't sized to TikTok's UI, so an imported PNG is the more accurate route. Toggle the track's visibility (the eye icon) off before you export.",
	},
	{
		q: 'Are TikTok safe zones organic the same as TikTok ads safe zones?',
		a: "Largely the same underlying 1080x1920 frame and UI placement, but ads specs are the more conservative, better-documented source, since a brand can't risk a cropped logo or CTA. For organic posts, the same figures apply in practice: the caption/username/sound band and the icon rail cover an identical footprint whether a video is boosted or posted for free, so one template works for both.",
	},
	{
		q: 'Does this work for Instagram too?',
		a: "TikTok and Instagram Reels reserve similar but not identical space. See the dedicated Instagram safe zone template page for the exact Reels, Story, and Post dimensions instead of reusing TikTok's figures.",
	},
];
---

<Layout {title} {description} {keywords} {path} structuredData={structuredData}>
	<Navbar variant="landing" />
	<main>
		<Breadcrumbs
			items={[
				{ label: 'Home', href: '/' },
				{ label: 'Guides' },
				{ label: 'TikTok Safe Zone Template' },
			]}
		/>

		<section class="mx-auto flex w-full max-w-3xl flex-col items-center px-4 pb-4 text-center sm:px-6">
			<span class="mb-4 font-mono text-xs tracking-wide text-mute">2026 TEMPLATE</span>
			<h1 class="font-sans text-4xl font-semibold tracking-[-0.03em] text-ink sm:text-5xl">
				TikTok safe zone template
			</h1>
			<p class="mt-5 max-w-xl text-base leading-7 text-body">
				The exact 1080x1920 dimensions TikTok reserves for its own UI, plus how to turn them into a
				guide layer inside CapCut or Premiere Pro before you export.
			</p>
		</section>

		<section class="mx-auto w-full max-w-3xl px-4 py-14 sm:px-6">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">THE TEMPLATE</span>
			<h2 class="font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">
				TikTok's safe zone, in pixels and percent
			</h2>
			<div class="mt-6 overflow-x-auto">
				<table class="w-full min-w-[520px] border-collapse text-left">
					<thead>
						<tr class="border-b border-hairline">
							<th class="py-2.5 pr-4 font-mono text-[11px] font-medium tracking-wide text-mute uppercase">Zone</th>
							<th class="py-2.5 pr-4 font-mono text-[11px] font-medium tracking-wide text-mute uppercase">Depth</th>
							<th class="py-2.5 pr-4 font-mono text-[11px] font-medium tracking-wide text-mute uppercase">Position</th>
						</tr>
					</thead>
					<tbody>
						<tr class="border-b border-hairline align-top">
							<td class="py-3 pr-4 font-sans text-sm font-medium whitespace-nowrap text-ink">Top bar</td>
							<td class="py-3 pr-4 font-mono text-xs whitespace-nowrap text-mute">{topMetric.px}px ({topMetric.percent}%)</td>
							<td class="py-3 pr-4 text-sm leading-6 text-body">Following / For You switcher, full width, pinned to the top edge</td>
						</tr>
						<tr class="border-b border-hairline align-top">
							<td class="py-3 pr-4 font-sans text-sm font-medium whitespace-nowrap text-ink">Caption, username, sound</td>
							<td class="py-3 pr-4 font-mono text-xs whitespace-nowrap text-mute">{captionMetric.px}px ({captionMetric.percent}%)</td>
							<td class="py-3 pr-4 text-sm leading-6 text-body">Bottom band, roughly the last fifth of the frame's height</td>
						</tr>
						<tr class="border-b border-hairline align-top">
							<td class="py-3 pr-4 font-sans text-sm font-medium whitespace-nowrap text-ink">Like, comment, bookmark, share, profile</td>
							<td class="py-3 pr-4 font-mono text-xs whitespace-nowrap text-mute">{iconMetric.px}px ({iconMetric.percent}%)</td>
							<td class="py-3 pr-4 text-sm leading-6 text-body">Right-hand column, roughly the last seventh of the frame's width</td>
						</tr>
					</tbody>
				</table>
			</div>
			<p class="mt-4 text-sm leading-6 text-mute">
				Figures are at TikTok's standard {tiktok.frame.width}x{tiktok.frame.height} (9:16) export size and apply to
				both organic posts and ads. Close approximations based on TikTok's published specs, not
				pixel-exact measurements pulled from the live app.
			</p>
		</section>

		<section class="mx-auto w-full max-w-3xl px-4 pb-14 sm:px-6">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">USING THE TEMPLATE</span>
			<h2 class="font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">
				Turning it into a guide layer in your editor
			</h2>
			<div class="mt-6 flex flex-col gap-6 text-base leading-7 text-body">
				<div>
					<h3 class="font-sans text-lg font-semibold text-ink">CapCut</h3>
					<p class="mt-2">
						Generate a reference PNG with the checker below, then add it through CapCut's Overlay
						feature so it sits on a layer above your main footage. Scale it to fill the full frame,
						drop its opacity to around 30-40%, and keep it on top while you place captions, faces,
						and logos. Delete or hide the overlay clip before your final export so it never renders
						into the video.
					</p>
				</div>
				<div>
					<h3 class="font-sans text-lg font-semibold text-ink">Premiere Pro</h3>
					<p class="mt-2">
						Import the reference PNG as a clip and place it on a track above your footage. Select it,
						open Effect Controls, and lower Opacity to roughly 30-40%. Premiere's built-in Safe
						Margins overlay (the wrench icon on the Program Monitor) shows a generic action/title-safe
						guide, but it isn't sized to TikTok's UI, an imported PNG lined up to the table above is
						the more accurate route. Toggle the track's visibility off before exporting.
					</p>
				</div>
			</div>
		</section>

		<section class="mx-auto w-full max-w-3xl px-4 pb-14 sm:px-6">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">GENERATE YOURS</span>
			<h2 class="font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">
				Check it against your own photo first
			</h2>
			<p class="mt-4 text-base leading-7 text-body">
				Before building a guide layer by hand, drop a frame grab or thumbnail into the interactive
				checker to see these zones drawn to scale on your actual composition, and export a reference
				PNG straight from it.
			</p>
			<a
				href="/tiktok-safe-zone/"
				class="mt-6 inline-block rounded-md bg-primary px-5 py-2.5 font-sans text-sm font-medium text-on-primary transition-opacity hover:opacity-90"
			>
				Open the TikTok safe zone checker →
			</a>
		</section>

		<section class="mx-auto w-full max-w-3xl px-4 pb-14 sm:px-6">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">TIKTOK TEMPLATE, NOT AN APP DOWNLOAD</span>
			<h2 class="font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">
				Why this tiktok template beats a static PNG pack
			</h2>
			<div class="mt-6 flex flex-col gap-5 text-base leading-7 text-body">
				<p>
					Most searches for a tiktok template turn up either a tiktok template app to install or a
					paid tiktok template png pack that was measured once and never rechecked. Both go stale
					the moment TikTok nudges its own UI. The table above is that same tiktok template, kept
					current, and paired with the interactive checker so it's never just a flat tiktok safe
					zone overlay you have to eyeball, it's drawn to scale on your own footage.
				</p>
				<p>
					If a downloadable tiktok safe zone png is specifically what you need for a guide layer,
					export one straight from the checker below rather than a generic pack: it'll match your
					own frame's dimensions instead of an average someone else measured.
				</p>
			</div>
		</section>

		<section class="mx-auto w-full max-w-3xl px-4 pb-14 sm:px-6">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">GO DEEPER</span>
			<h2 class="font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">
				More safe zone tools
			</h2>
			<div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
				<a href="/tiktok-safe-zone/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">TikTok safe zone checker</span>
					<span class="mt-1 block font-mono text-xs text-mute">Overlay the template on your own photo</span>
				</a>
				<a href="/instagram-safe-zone-template/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">Instagram safe zone template</span>
					<span class="mt-1 block font-mono text-xs text-mute">Dimensions for Reels, Story & Post</span>
				</a>
				<a href="/instagram-reels-safe-zone/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">Instagram Reels safe zone checker</span>
					<span class="mt-1 block font-mono text-xs text-mute">The same check, tuned to Reels' UI</span>
				</a>
				<a href="/guides/social-media-safe-zones/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">Social media safe zone guide</span>
					<span class="mt-1 block font-mono text-xs text-mute">Every platform's dimensions, in one reference</span>
				</a>
			</div>
		</section>

		<MovieFaq eyebrow="FAQ" heading="Common questions about the TikTok safe zone template" faqs={faqs} />

		<script type="application/ld+json" set:html={JSON.stringify(howToStructuredData)} />
	</main>
	<Footer />
</Layout>
