---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import DropZone from '../components/DropZone.astro';
import SeoContent from '../components/SeoContent.astro';
import Footer from '../components/Footer.astro';
import AdSlot from '../components/AdSlot.astro';
---

<Layout>
	<Navbar variant="landing" />
	<main>
		<DropZone
			presetIds={[
				'dark-knight',
				'blade-runner',
				'dune',
				'interstellar',
				'matrix',
				'breaking-bad',
				'stranger-things',
				'game-of-thrones',
				'dark',
				'peaky-blinders',
			]}
		/>
		<AdSlot />

		<section class="mx-auto w-full max-w-3xl px-4 py-14 sm:px-6">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">FREE TOOLS</span>
			<h2 class="font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">
				Check your content before you publish
			</h2>
			<p class="mt-4 max-w-xl text-base leading-7 text-body">
				Free browser tools that show how your photo or thumbnail will actually look once it's
				live, a platform's own UI overlaid on top, or a thumbnail shrunk down to feed size.
			</p>
			<div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
				<a href="/tools/youtube-thumbnail-preview/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">YouTube thumbnail preview tool</span>
					<span class="mt-1 block font-mono text-xs text-mute">See it in search, suggested, and mobile</span>
				</a>
				<a href="/tiktok-safe-zone/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">TikTok safe zone checker</span>
					<span class="mt-1 block font-mono text-xs text-mute">Single-platform version, focused on TikTok</span>
				</a>
				<a href="/instagram-reels-safe-zone/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">Instagram Reels safe zone checker</span>
					<span class="mt-1 block font-mono text-xs text-mute">Single-platform version, focused on Reels</span>
				</a>
			</div>
		</section>

		<SeoContent />
	</main>
	<Footer />
</Layout>

<script>
	import '../lib/landing';
</script>
