---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import MovieFaq from '../components/MovieFaq.astro';
import { getPreset } from '../lib/presets';

// Paste the Dodo Payments product id for the LUT pack here (Dodo dashboard > Products).
// While empty, the buy buttons render as a disabled "Coming soon" state.
const DODO_LUT_PACK_ID = 'pdt_0NphgvBQVEG3XN4CEumS3';
const checkoutUrl = DODO_LUT_PACK_ID
	? `https://checkout.dodopayments.com/buy/${DODO_LUT_PACK_ID}?redirect_url=${encodeURIComponent(new URL('/cinematic-luts/thank-you/', Astro.url.origin).href)}`
	: '';

const path = '/cinematic-luts/';
const title = 'Cinematic LUT Pack (.cube) for Premiere, Resolve & CapCut | Movie Color Grades';
const description =
	'Four cinematic .cube LUTs inspired by The Dark Knight, Blade Runner 2049, Dune and The Matrix. Works in DaVinci Resolve, Premiere Pro, Final Cut Pro, CapCut and Photoshop. Instant download.';
const keywords =
	'cinematic luts, movie luts, cube lut pack, cinematic lut pack, dark knight lut, blade runner lut, dune lut, matrix lut, free cinematic luts, premiere pro luts, davinci resolve luts, capcut luts';

const luts = [
	{ id: 'dark-knight', file: 'Dark Knight Steel.cube', blurb: 'Cold steel, crushed blacks' },
	{ id: 'blade-runner', file: 'Blade Runner Neon.cube', blurb: 'Amber neon, teal haze' },
	{ id: 'dune', file: 'Dune Desert Gold.cube', blurb: 'Desert gold, blown highlights' },
	{ id: 'matrix', file: 'Matrix Green.cube', blurb: 'High-gain digital green' },
].map((l) => ({ ...l, preset: getPreset(l.id) }));

const software = [
	['DaVinci Resolve', 'Project Settings > Color Management > Open LUT Folder, drop the files in, then right-click a clip > LUT.'],
	['Premiere Pro', 'Lumetri Color > Creative > Look dropdown > Browse, then pick a .cube file.'],
	['Final Cut Pro', 'Add the Custom LUT effect to a clip and choose the .cube file.'],
	['CapCut', 'Adjust > LUT > Import, then choose the .cube file.'],
	['Photoshop', 'Layer > New Adjustment Layer > Color Lookup > 3DLUT File > Load 3D LUT.'],
];

const faqs = [
	{
		q: 'What format are the LUTs?',
		a: 'Standard 33-point .cube 3D LUTs, the format read by DaVinci Resolve, Premiere Pro, Final Cut Pro, CapCut, Photoshop, OBS and most other editors.',
	},
	{
		q: 'Will they work on my footage?',
		a: 'They are built for normal display-referred footage and photos (sRGB / Rec.709). If you shoot in a Log profile, convert to Rec.709 first, then apply the LUT. Lowering the LUT intensity to 60 to 80 percent often looks most natural.',
	},
	{
		q: 'Do the LUTs include grain, vignette or glow?',
		a: 'No. A LUT only changes color. Grain, vignette and glow are separate effects, which you can add in your editor or with the free Cinematic Photo editor.',
	},
	{
		q: 'Does it work for photos, not just video?',
		a: 'Yes. Any app that loads a .cube LUT can apply it to a photo, including Photoshop and many mobile editors. Lightroom does not load .cube files natively.',
	},
	{
		q: 'How do I get the files after paying?',
		a: 'Checkout is handled by Dodo Payments. Right after payment you get a download link for the zip, and a copy is emailed to you.',
	},
	{
		q: 'Will more LUTs be added?',
		a: 'Yes, more looks are planned for future releases. New looks will be sold as separate packs, so this purchase covers the four LUTs listed on this page. Check back here for new packs.',
	},
	{
		q: 'Are these official film LUTs?',
		a: 'No. They are independent color grades inspired by the look of these films. They are not affiliated with or endorsed by any studio or filmmaker.',
	},
	{
		q: 'Can I use them commercially?',
		a: 'Yes, in your own client and personal photo and video projects. You may not resell, redistribute or share the LUT files themselves.',
	},
];

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'Product',
	name: 'Cinematic LUT Pack (.cube)',
	description,
	url: `https://cinematicphoto.com${path}`,
	image: 'https://cinematicphoto.com/og-image.png',
	brand: { '@type': 'Brand', name: 'Cinematic Photo' },
};
---

<Layout {title} {description} {keywords} {path} structuredData={structuredData}>
	<Navbar variant="landing" />
	<main>
		<Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Cinematic LUT Pack' }]} />

		<section class="mx-auto flex w-full max-w-3xl flex-col items-center px-4 pb-4 text-center sm:px-6">
			<span class="mb-4 font-mono text-xs tracking-wide text-mute">DIGITAL DOWNLOAD</span>
			<h1 class="font-sans text-4xl font-semibold tracking-[-0.03em] text-ink sm:text-5xl">
				Cinematic LUT pack
			</h1>
			<p class="mt-5 max-w-xl text-base leading-7 text-body">
				Four movie-inspired .cube LUTs for video and photos. Drop one on a clip and get the look in
				one click, in DaVinci Resolve, Premiere Pro, Final Cut Pro, CapCut or Photoshop.
			</p>
			{
				checkoutUrl ? (
					<a
						href={checkoutUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="mt-7 inline-block rounded-md bg-primary px-6 py-3 font-sans text-sm font-medium text-on-primary transition-opacity hover:opacity-90"
					>
						Get the LUT pack
					</a>
				) : (
					<span class="mt-7 inline-block cursor-not-allowed rounded-md border border-hairline px-6 py-3 font-sans text-sm font-medium text-mute">
						Coming soon
					</span>
				)
			}
			<span class="mt-3 font-mono text-xs text-mute">Instant download · 4 LUTs · .cube · commercial use</span>
			<span class="mt-2 font-mono text-xs text-mute">More looks are coming soon</span>
		</section>

		<section class="mx-auto w-full max-w-3xl px-4 py-14 sm:px-6">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">WHAT'S INSIDE</span>
			<h2 class="font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">
				Four looks, ready to apply
			</h2>
			<div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
				{
					luts.map((l) => (
						<figure class="flex flex-col gap-2">
							<span class="relative block aspect-[4/5] w-full overflow-hidden rounded-md border border-hairline bg-canvas-soft">
								<img
									loading="lazy"
									decoding="async"
									alt={`Photo graded with the ${l.preset.name} inspired look`}
									src={l.preset.image}
									class="absolute inset-0 h-full w-full object-cover"
								/>
							</span>
							<figcaption>
								<span class="block font-sans text-sm font-medium text-ink">{l.preset.name}</span>
								<span class="block font-mono text-xs text-mute">{l.blurb} · {l.file}</span>
							</figcaption>
						</figure>
					))
				}
			</div>
			<p class="mt-4 text-sm leading-6 text-mute">
				Previews show the matching look from the free editor. You can try each one on your own photo
				before buying, in the <a href="/presets/" class="text-ink underline underline-offset-2">preset library</a>.
			</p>
		</section>

		<section class="mx-auto w-full max-w-3xl px-4 pb-14 sm:px-6">
			<div class="rounded-md border border-hairline bg-canvas-soft p-5">
				<span class="block font-mono text-xs tracking-wide text-mute">COMING SOON</span>
				<h2 class="mt-2 font-sans text-xl font-semibold tracking-[-0.02em] text-ink">
					More cinematic LUTs are on the way
				</h2>
				<p class="mt-2 text-base leading-7 text-body">
					This is the first pack. More movie-inspired looks are being built for future releases.
				</p>
			</div>
		</section>

		<section class="mx-auto w-full max-w-3xl px-4 pb-14 sm:px-6">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">HOW TO USE</span>
			<h2 class="font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">
				Works in the editors you already use
			</h2>
			<div class="mt-6 overflow-x-auto">
				<table class="w-full min-w-[520px] border-collapse text-left">
					<tbody>
						{
							software.map(([name, how]) => (
								<tr class="border-b border-hairline align-top">
									<td class="py-3 pr-4 font-sans text-sm font-medium whitespace-nowrap text-ink">{name}</td>
									<td class="py-3 text-sm leading-6 text-body">{how}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
		</section>

		<section class="mx-auto flex w-full max-w-3xl flex-col items-center px-4 pb-14 text-center sm:px-6">
			<h2 class="font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">
				Get all four LUTs
			</h2>
			<p class="mt-3 max-w-md text-base leading-7 text-body">
				One zip with the LUTs and a short setup guide. Sold through Dodo Payments.
			</p>
			{
				checkoutUrl ? (
					<a
						href={checkoutUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="mt-6 inline-block rounded-md bg-primary px-6 py-3 font-sans text-sm font-medium text-on-primary transition-opacity hover:opacity-90"
					>
						Get the LUT pack
					</a>
				) : (
					<span class="mt-6 inline-block cursor-not-allowed rounded-md border border-hairline px-6 py-3 font-sans text-sm font-medium text-mute">
						Coming soon
					</span>
				)
			}
		</section>

		<MovieFaq eyebrow="FAQ" heading="Common questions about the LUT pack" faqs={faqs} />
	</main>
	<Footer />
</Layout>
