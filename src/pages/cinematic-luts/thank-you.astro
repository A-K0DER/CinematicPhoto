---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const path = '/cinematic-luts/thank-you/';
const title = 'Thank You | Cinematic LUT Pack';
const description = 'Your Cinematic LUT Pack purchase: where to find your download link.';
---

<Layout {title} {description} {path} noindex>
	<Navbar />
	<main class="mx-auto flex max-w-2xl flex-col items-center px-4 py-24 text-center sm:px-6">
		<div id="state-success" class="flex flex-col items-center">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">PAYMENT RECEIVED</span>
			<h1 class="font-sans text-3xl font-semibold tracking-[-0.03em] text-ink sm:text-4xl">
				Thanks for your purchase
			</h1>
			<p class="mt-4 max-w-md text-base leading-7 text-body">
				Your download link is on its way to <span id="buyer-email" class="font-medium text-ink">the email you used at checkout</span>.
				It usually arrives within a minute or two.
			</p>

			<div class="mt-10 w-full rounded-md border border-hairline bg-canvas-soft p-5 text-left">
				<span class="block font-mono text-xs tracking-wide text-mute">IF YOU DON'T SEE IT</span>
				<ul class="mt-3 flex flex-col gap-2 text-sm leading-6 text-body">
					<li>Check your spam, junk and promotions folders. The email comes from Dodo Payments, our payment provider.</li>
					<li>Download links expire after a short time for security. Open the link in the email again, or use the customer portal button in the email, to get a fresh one.</li>
					<li>Make sure you used the right address. If it still doesn't arrive, contact us and we'll sort it out.</li>
				</ul>
			</div>

			<div class="mt-6 w-full rounded-md border border-hairline p-5 text-left">
				<span class="block font-mono text-xs tracking-wide text-mute">WHEN YOU HAVE THE FILES</span>
				<ol class="mt-3 flex list-decimal flex-col gap-2 pl-5 text-sm leading-6 text-body">
					<li>Unzip the download. Inside is a <span class="font-medium text-ink">LUTs</span> folder with four .cube files and a "READ ME.txt".</li>
					<li>Import a .cube file in DaVinci Resolve, Premiere Pro, Final Cut Pro, CapCut or Photoshop. The READ ME has the steps for each.</li>
					<li>Lower the LUT intensity to 60 to 80 percent if the look feels too strong.</li>
				</ol>
			</div>
		</div>

		<div id="state-problem" class="hidden flex-col items-center">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">PAYMENT NOT COMPLETED</span>
			<h1 class="font-sans text-3xl font-semibold tracking-[-0.03em] text-ink sm:text-4xl">
				Your payment didn't go through
			</h1>
			<p class="mt-4 max-w-md text-base leading-7 text-body">
				You haven't been charged for this order. You can try again with the same or a different payment method.
			</p>
			<a
				href="/cinematic-luts/"
				class="mt-8 rounded-md bg-primary px-4 py-2 font-sans text-sm font-medium text-on-primary transition-opacity hover:opacity-90"
			>
				Back to the LUT pack
			</a>
		</div>

		<div class="mt-10 flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
			<a href="/contact-us/" class="font-sans text-sm text-body underline underline-offset-2 hover:text-ink">Contact us</a>
			<a href="/presets/" class="font-sans text-sm text-body underline underline-offset-2 hover:text-ink">Try the free preset editor</a>
		</div>
	</main>
	<Footer />
</Layout>

<script is:inline>
	(function () {
		var params = new URLSearchParams(window.location.search);
		var status = params.get('status');
		if (status === 'failed' || status === 'expired') {
			document.getElementById('state-success').classList.add('hidden');
			var problem = document.getElementById('state-problem');
			problem.classList.remove('hidden');
			problem.classList.add('flex');
			return;
		}
		var email = params.get('email');
		if (email) document.getElementById('buyer-email').textContent = email;
	})();
</script>
