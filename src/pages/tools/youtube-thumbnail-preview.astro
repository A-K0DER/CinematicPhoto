---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import YouTubeThumbnailPreview from '../../components/YouTubeThumbnailPreview.astro';
import MovieFaq from '../../components/MovieFaq.astro';

const path = '/tools/youtube-thumbnail-preview/';
const title = 'YouTube Thumbnail Preview Tool | Free, No Upload';
const description =
	"See exactly how a YouTube thumbnail, title, and channel name will look in suggested videos, search results, and the mobile feed, before you publish. Runs entirely in your browser.";
const keywords =
	'youtube thumbnail preview, youtube thumbnail size, youtube thumbnail maker, youtube thumbnail checker, youtube thumbnail grabber, youtube thumbnail viewer, youtube thumbnail tester, youtube title preview, youtube search result preview, youtube thumbnail small size test, youtube thumbnail simulator';

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'WebApplication',
	name: 'YouTube Thumbnail Preview Tool',
	url: `https://cinematicphoto.com${path}`,
	description,
	applicationCategory: 'DesignApplication',
	operatingSystem: 'Any (runs in browser)',
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
	isAccessibleForFree: true,
};

const howToStructuredData = {
	'@context': 'https://schema.org',
	'@type': 'HowTo',
	name: 'How to preview a YouTube thumbnail before publishing',
	description:
		'Upload a thumbnail and fill in a title, channel name, view count, and duration to see how it will look in suggested videos, search results, and the mobile home feed.',
	step: [
		{
			'@type': 'HowToStep',
			name: 'Upload a thumbnail',
			text: 'Drop a thumbnail image, paste it, or click to upload a JPG, PNG, or WEBP file, ideally 1280x720.',
		},
		{
			'@type': 'HowToStep',
			name: 'Fill in the video details',
			text: 'Enter a title, channel name, view count, upload time, and duration to match a real video.',
		},
		{
			'@type': 'HowToStep',
			name: 'Compare placements',
			text: 'Check how the thumbnail and title read in suggested videos, search results, and the mobile home feed.',
		},
		{
			'@type': 'HowToStep',
			name: 'Run the small-size check',
			text: 'Look at the thumbnail at 168px, 112px, and 64px wide to confirm it still reads at a glance.',
		},
	],
};

const faqs = [
	{
		q: 'What is a YouTube thumbnail?',
		a: "It's the small preview image shown for a video everywhere it appears outside the watch page, suggested videos, search results, the subscriptions feed, and playlists. YouTube can auto-generate one from a frame of the video, but a custom thumbnail, an image uploaded separately from the footage, is what almost every channel actually uses, since it can be designed around a title, a face, or a specific composition rather than left to whatever frame YouTube happens to grab.",
	},
	{
		q: 'What is a thumbnail on YouTube?',
		a: "Same thing as a YouTube thumbnail: the still image that represents a video before someone clicks play. YouTube offers three auto-generated options pulled from the video itself, but any channel that's verified its phone number can upload a custom thumbnail instead, which is what this preview tool is built to check before it goes live.",
	},
	{
		q: 'What size is a YouTube thumbnail?',
		a: "1280x720 pixels at a 16:9 aspect ratio is YouTube's recommended thumbnail size. That matches the video frame itself, so a thumbnail exported at that size lines up with how YouTube actually displays and crops it, rather than getting stretched or unexpectedly cropped in the UI.",
	},
	{
		q: 'How big is a YouTube thumbnail?',
		a: 'As a file, YouTube caps a custom thumbnail upload at 2MB, in JPG, GIF, PNG, or BMP format. As an image, the recommended size is 1280x720 pixels, with a hard minimum width of 640 pixels, anything narrower gets rejected on upload.',
	},
	{
		q: 'What is the size of a YouTube thumbnail?',
		a: "1280x720 pixels, even though it's rarely displayed anywhere near that large, a sidebar suggestion shows it around 168px wide, and a mobile feed card isn't much bigger either. Uploading at the full 1280x720 keeps the image sharp on the rare placements that do show it larger, like a maximized search result or a TV screen.",
	},
	{
		q: 'What is the YouTube thumbnail size?',
		a: "The full spec: 1280x720 pixels, a 16:9 aspect ratio, a 640px minimum width, and a 2MB maximum file size in JPG, GIF, PNG, or BMP. Design to that size, then use this tool's small-size check (168px, 112px, 64px) to see whether it still reads once YouTube shrinks it back down for suggested videos and search.",
	},
	{
		q: 'How do I make a thumbnail for YouTube?',
		a: "Start from a still that reads clearly at a glance, a face with a clear expression, high contrast, and minimal text usually outperforms a busy frame, export it at 1280x720 (16:9), and keep any text large enough to survive being shown at 168px wide in a sidebar. This tool doesn't design the thumbnail itself, but once you've made one, drop it in above to see how it and its title actually look in suggested videos, search results, and the mobile feed before you publish. For the full set of composition and contrast rules, see the YouTube thumbnail design guide.",
	},
	{
		q: 'Does this tool upload my thumbnail anywhere?',
		a: 'No. The image is drawn straight into the page and never leaves your browser, the same client-side approach used by the rest of the site.',
	},
	{
		q: 'Why does the thumbnail look cropped differently than what I uploaded?',
		a: "YouTube center-crops any thumbnail that isn't exactly 16:9 down to that ratio in its UI, so this tool applies the same center-crop rather than stretching or letterboxing the image, matching what viewers will actually see.",
	},
	{
		q: 'Why does the same thumbnail look different in each preview?',
		a: "Suggested videos, search results, and the mobile feed each show the thumbnail at a different width and pair it with a different amount of title and metadata, so a design that reads clearly in one spot can lose detail in another. Comparing all three catches that before you publish.",
	},
	{
		q: "What's the small-size check for?",
		a: "Most viewers scroll past a thumbnail at a small size, on a phone, in a sidebar, or in a crowded grid, not full-size on a desktop monitor. Shrinking the thumbnail down to 168px, 112px, and 64px wide is a quick gut-check for whether the subject and any text still read at a glance.",
	},
	{
		q: 'Are the view count and title truncation rules exact?',
		a: "They're close approximations of YouTube's own abbreviation and line-clamp behavior, not pixel-perfect measurements pulled from the live site. YouTube tweaks its UI over time, so treat this as a composition and legibility check, not a guarantee of the exact live layout.",
	},
	{
		q: 'Can I use this to design the thumbnail itself?',
		a: "No, it's a preview tool for a thumbnail you've already made, not an editor. For color grading a photo before turning it into a thumbnail, see the cinematic YouTube thumbnail filter page.",
	},
];
---

<Layout {title} {description} {keywords} {path} structuredData={structuredData}>
	<Navbar variant="landing" />
	<main>
		<Breadcrumbs
			items={[
				{ label: 'Home', href: '/' },
				{ label: 'Tools' },
				{ label: 'YouTube Thumbnail Preview' },
			]}
		/>

		<section class="mx-auto mt-6 flex w-full max-w-3xl flex-col items-center px-4 pb-4 text-center sm:px-6">
			<span class="mb-4 font-mono text-xs tracking-wide text-mute">FREE TOOL</span>
			<h1 class="font-sans text-4xl font-semibold tracking-[-0.03em] text-ink sm:text-5xl">
				YouTube thumbnail preview tool
			</h1>
			<p class="mt-5 max-w-xl text-base leading-7 text-body">
				Upload a thumbnail and see how it, and your title, will actually look in suggested videos,
				search results, and the mobile feed, before you publish.
			</p>
		</section>

		<YouTubeThumbnailPreview />

		<section class="mx-auto w-full max-w-3xl px-4 py-14 sm:px-6">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">WHY IT MATTERS</span>
			<h2 class="font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">
				A thumbnail that only gets judged at full size
			</h2>
			<div class="mt-6 flex flex-col gap-5 text-base leading-7 text-body">
				<p>
					A thumbnail that looks sharp and legible full-size in a design tool can turn into a muddy,
					unreadable blob once it's shrunk down to a 168px sidebar suggestion or a phone screen. The
					title next to it gets clipped by YouTube's own line limits too, so a clever opening line
					can end up cut off mid-sentence in some placements and not others.
				</p>
				<p>
					Checking a thumbnail and title against suggested videos, search results, and the mobile
					feed, at the actual sizes viewers see them, catches both problems before a video goes live
					instead of after.
				</p>
			</div>
		</section>

		<section class="mx-auto w-full max-w-3xl px-4 pb-14 sm:px-6">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">SIZE, CHECKER &amp; VIEWER</span>
			<h2 class="font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">
				Not a maker or a grabber, a checker for what you've already made
			</h2>
			<div class="mt-6 flex flex-col gap-5 text-base leading-7 text-body">
				<p>
					YouTube's recommended youtube thumbnail size is 1280x720 at a 16:9 ratio, and this tool's
					upload frame is built around that exact size, so whatever comes out of a thumbnail maker,
					a screenshot, or a quick crop lines up the same way it will once it's live. It isn't a
					youtube thumbnail maker itself, there's no drawing or text tool here, and it isn't a
					youtube thumbnail grabber either, it won't pull an existing thumbnail off someone else's
					video by URL.
				</p>
				<p>
					What it is: a youtube thumbnail checker and a youtube thumbnail viewer for a file you
					already have, upload it and see it rendered at real placement sizes across suggested
					videos, search results, and the mobile feed, plus a dedicated small-size viewer at 168px,
					112px, and 64px, the sizes it'll actually be judged at by someone scrolling past.
				</p>
			</div>
		</section>

		<section class="mx-auto w-full max-w-3xl px-4 pb-14 sm:px-6">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">GO DEEPER</span>
			<h2 class="font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">
				More tools for creators
			</h2>
			<div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
				<a href="/for/youtube-thumbnails/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">Cinematic YouTube thumbnails</span>
					<span class="mt-1 block font-mono text-xs text-mute">Bold, high-contrast presets for creators</span>
				</a>
				<a href="/instagram-reels-safe-zone/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">Instagram &amp; TikTok safe zone checkers</span>
					<span class="mt-1 block font-mono text-xs text-mute">Check composition against platform UI</span>
				</a>
				<a href="/guides/youtube-thumbnail-design/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">YouTube thumbnail design guide</span>
					<span class="mt-1 block font-mono text-xs text-mute">The rules that actually move click-through</span>
				</a>
				<a href="/guides/how-to-make-photos-look-cinematic/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">How to make photos look cinematic</span>
					<span class="mt-1 block font-mono text-xs text-mute">The complete step-by-step guide</span>
				</a>
				<a href="/presets/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">Browse all 60 presets</span>
					<span class="mt-1 block font-mono text-xs text-mute">Every color grade, organized by genre</span>
				</a>
			</div>
		</section>

		<MovieFaq eyebrow="FAQ" heading="Common questions about the thumbnail preview tool" faqs={faqs} />

		<script type="application/ld+json" set:html={JSON.stringify(howToStructuredData)} />
	</main>
	<Footer />
</Layout>
