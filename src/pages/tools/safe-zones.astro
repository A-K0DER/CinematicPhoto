---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SafeZoneTool from '../../components/SafeZoneTool.astro';
import MovieFaq from '../../components/MovieFaq.astro';

const path = '/tools/safe-zones/';
const title = 'TikTok & Instagram Reels Safe Zone Checker | Free Tool';
const description =
	'Drop a photo or thumbnail onto a 9:16 frame and see exactly where TikTok\'s and Instagram Reels\' own UI, captions, username, sound, and the like/comment/share rail, will sit on top of it.';
const keywords =
	'tiktok safe zone, instagram reels safe zone, tiktok safe area template, reels safe area, vertical video safe zone, tiktok caption safe zone, reels caption safe zone, 9:16 safe zone, instagram and tiktok safe zone template';

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'WebApplication',
	name: 'TikTok & Instagram Reels Safe Zone Checker',
	url: `https://cinematicphoto.com${path}`,
	description,
	applicationCategory: 'DesignApplication',
	operatingSystem: 'Any (runs in browser)',
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
	isAccessibleForFree: true,
};

const howToStructuredData = {
	'@context': 'https://schema.org',
	'@type': 'HowTo',
	name: 'How to check TikTok and Instagram Reels safe zones on a photo',
	description: "Overlay TikTok's and Instagram Reels' caption, username, and engagement icon bands on a photo before posting, and compare both platforms side by side.",
	step: [
		{
			'@type': 'HowToStep',
			name: 'Upload a photo',
			text: 'Drop a photo or thumbnail onto the tool, paste it, or click to upload a JPG, PNG, or WEBP file.',
		},
		{
			'@type': 'HowToStep',
			name: 'Toggle platforms',
			text: 'Toggle TikTok and Instagram Reels overlays on or off independently to compare how each app reserves space.',
		},
		{
			'@type': 'HowToStep',
			name: 'Reposition inside the frame',
			text: 'Drag inside the frame to reposition the photo within the 9:16 export crop.',
		},
		{
			'@type': 'HowToStep',
			name: 'Save a reference image',
			text: 'Adjust the overlay opacity if needed, then save the cropped reference image or a transparent overlay PNG.',
		},
	],
};

const faqs = [
	{
		q: 'What is a "safe zone" for TikTok and Instagram Reels?',
		a: "It's the part of a vertical 9:16 frame that the app's own interface, caption text, username, sound title, and the like/comment/bookmark/share icon column, sits on top of. Anything important placed there (a face, a subtitle, a product) gets partly or fully covered while someone is actually watching.",
	},
	{
		q: 'Are TikTok and Instagram Reels safe zones the same?',
		a: "Close, but not identical. Both reserve a bottom band for caption/username/audio and a right-hand column for engagement icons, but the exact size and position differ slightly between the two apps, which is why this tool shows them as separate overlays you can toggle independently.",
	},
	{
		q: 'Are these safe zone measurements exact?',
		a: "They're close approximations based on each app's published creator and ads specs, not pixel-perfect measurements pulled from the live apps. Both TikTok and Instagram tweak their UI over time, so treat the guides as a composition check, not a guarantee.",
	},
	{
		q: 'Does this tool upload my photo anywhere?',
		a: 'No. The image is drawn straight into an on-page canvas and never leaves your browser, the same client-side approach used by the rest of the site.',
	},
	{
		q: 'Can I use this for a photo post, not just video?',
		a: "Yes. It works the same way for a Reels/TikTok cover image or a vertical photo post, anywhere you want to check that a face, text, or key detail won't land under the app's UI.",
	},
	{
		q: 'How is this different from the cinematic photo editor?',
		a: "It's a separate, single-purpose tool. The cinematic editor applies color grading presets and exports a finished photo; this tool only checks composition against platform UI overlap and isn't connected to presets, grading, or exports from the editor.",
	},
	{
		q: 'Which platform reserves more space, TikTok or Reels?',
		a: "Reels reserves a slightly taller bottom caption band (about 24% of height vs. TikTok's roughly 20%), while TikTok's right-hand icon column runs a bit wider (about 14% of width vs. Reels' roughly 12%). Neither gap is huge, but it's enough that content sitting right at the edge of one platform's safe zone can get clipped on the other.",
	},
	{
		q: 'Should I design one thumbnail for both platforms, or two separate ones?',
		a: "If a face, subtitle, or product detail sits inside the safe area on both overlays at once, one design works for both. If it only clears one platform's zones, it's worth nudging the composition, or cropping two versions, one per app, rather than risking a key detail getting covered on whichever platform it doesn't clear.",
	},
	{
		q: "What's the ideal video size for TikTok and Reels?",
		a: '1080x1920 pixels at a 9:16 aspect ratio is the standard export size both platforms expect, for organic posts and ads alike. This tool\'s frame matches that resolution, so the safe-zone measurements line up directly with whatever you export from your camera or editor.',
	},
	{
		q: 'Is there a single Instagram and TikTok safe zone template?',
		a: "This tool is the closest thing to one: it overlays both platforms' zones on the same 1080x1920 photo so you can see where they overlap and where they don't, instead of switching between two separate templates. For a written breakdown of TikTok's dimensions specifically, plus how to turn them into a guide layer in CapCut or Premiere Pro, see the TikTok safe zone template page.",
	},
];
---

<Layout {title} {description} {keywords} {path} structuredData={structuredData}>
	<Navbar variant="landing" />
	<main>
		<Breadcrumbs
			items={[
				{ label: 'Home', href: '/' },
				{ label: 'Tools' },
				{ label: 'Safe Zones' },
			]}
		/>

		<section class="mx-auto flex w-full max-w-3xl flex-col items-center px-4 pb-4 text-center sm:px-6">
			<span class="mb-4 font-mono text-xs tracking-wide text-mute">FREE TOOL</span>
			<h1 class="font-sans text-4xl font-semibold tracking-[-0.03em] text-ink sm:text-5xl">
				TikTok &amp; Instagram Reels safe zone checker
			</h1>
			<p class="mt-5 max-w-xl text-base leading-7 text-body">
				Drop a photo onto a 9:16 frame to see where each app's caption, username, sound, and
				engagement icons will sit on top of it, before you post.
			</p>
		</section>

		<SafeZoneTool />

		<section class="mx-auto w-full max-w-3xl px-4 py-14 sm:px-6">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">WHY IT MATTERS</span>
			<h2 class="font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">
				Composition that survives the app's own UI
			</h2>
			<div class="mt-6 flex flex-col gap-5 text-base leading-7 text-body">
				<p>
					A vertical frame that looks perfectly composed in a raw export can still lose its subject
					once TikTok or Instagram lays captions, a username, a sound title, and a column of
					like/comment/share icons on top of it. Checking against both platforms' safe zones before
					posting means a face, a subtitle, or a key product detail doesn't end up hidden behind the
					app's own chrome.
				</p>
				<p>
					TikTok and Instagram Reels reserve similar but not identical space, both keep a bottom
					band for caption/username/audio and a right-hand column for engagement icons, so this tool
					overlays each app's zones separately and lets you toggle them independently.
				</p>
			</div>
		</section>

		<section class="mx-auto w-full max-w-3xl px-4 pb-14 sm:px-6">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">GO DEEPER</span>
			<h2 class="font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">
				More tools for creators
			</h2>
			<div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
				<a href="/tiktok-safe-zone/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">TikTok safe zone checker</span>
					<span class="mt-1 block font-mono text-xs text-mute">Single-platform version, focused on TikTok</span>
				</a>
				<a href="/tiktok-safe-zone-template/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">TikTok safe zone template</span>
					<span class="mt-1 block font-mono text-xs text-mute">Exact dimensions for CapCut & Premiere Pro</span>
				</a>
				<a href="/instagram-reels-safe-zone/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">Instagram Reels safe zone checker</span>
					<span class="mt-1 block font-mono text-xs text-mute">Single-platform version, focused on Reels</span>
				</a>
				<a href="/guides/social-media-safe-zones/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">Social media safe zone guide</span>
					<span class="mt-1 block font-mono text-xs text-mute">Every platform's dimensions, in one reference</span>
				</a>
				<a href="/for/instagram/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">Cinematic Instagram editor</span>
					<span class="mt-1 block font-mono text-xs text-mute">Presets plus 1:1 / 4:5 / 9:16 export crops</span>
				</a>
				<a href="/for/youtube-thumbnails/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">Cinematic YouTube thumbnails</span>
					<span class="mt-1 block font-mono text-xs text-mute">Bold, high-contrast presets for creators</span>
				</a>
				<a href="/tools/youtube-thumbnail-preview/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">YouTube thumbnail preview tool</span>
					<span class="mt-1 block font-mono text-xs text-mute">See it in search, suggested, and mobile</span>
				</a>
				<a href="/guides/how-to-make-photos-look-cinematic/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">How to make photos look cinematic</span>
					<span class="mt-1 block font-mono text-xs text-mute">The complete step-by-step guide</span>
				</a>
				<a href="/presets/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">Browse all 60 presets</span>
					<span class="mt-1 block font-mono text-xs text-mute">Every color grade, organized by genre</span>
				</a>
			</div>
		</section>

		<MovieFaq eyebrow="FAQ" heading="Common questions about safe zones" faqs={faqs} />

		<script type="application/ld+json" set:html={JSON.stringify(howToStructuredData)} />
	</main>
	<Footer />
</Layout>
