---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SafeZoneTool from '../components/SafeZoneTool.astro';
import MovieFaq from '../components/MovieFaq.astro';

const path = '/tiktok-safe-zone/';
const title = 'TikTok Safe Zone Checker | Free Caption & UI Overlay Tool';
const description =
	"Drop a photo or thumbnail onto a 9:16 frame and see exactly where TikTok's own caption, username, sound title, and like/comment/bookmark/share rail will sit on top of it.";
const keywords =
	'tiktok template, tiktok template png, tiktok template app, tiktok safe zone, tiktok safe area, tiktok safe zone template, tiktok safe zone overlay, tiktok caption safe zone, tiktok ui overlay, tiktok 1080x1920 safe zone, tiktok video safe zone, tiktok safe zone png, tiktok safe zone 2026';

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'WebApplication',
	name: 'TikTok Safe Zone Checker',
	url: `https://cinematicphoto.com${path}`,
	description,
	applicationCategory: 'DesignApplication',
	operatingSystem: 'Any (runs in browser)',
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
	isAccessibleForFree: true,
};

const howToStructuredData = {
	'@context': 'https://schema.org',
	'@type': 'HowTo',
	name: "How to check TikTok's safe zone on a photo",
	description: "Overlay TikTok's caption, username, sound title, and engagement icon bands on a photo before posting.",
	step: [
		{
			'@type': 'HowToStep',
			name: 'Upload a photo',
			text: 'Drop a photo or thumbnail onto the tool, paste it, or click to upload a JPG, PNG, or WEBP file.',
		},
		{
			'@type': 'HowToStep',
			name: 'Reposition inside the frame',
			text: "Drag inside the frame to reposition the photo within TikTok's 9:16 export crop.",
		},
		{
			'@type': 'HowToStep',
			name: "Check TikTok's UI overlay",
			text: "Review the dimmed bands showing TikTok's top bar, bottom caption/username/sound area, and right-hand engagement icon column drawn to scale on the photo.",
		},
		{
			'@type': 'HowToStep',
			name: 'Save a reference image',
			text: 'Adjust the overlay opacity if needed, then save the cropped reference image or a transparent overlay PNG.',
		},
	],
};

const faqs = [
	{
		q: 'What is TikTok\'s safe zone?',
		a: "It's the part of a vertical 9:16 frame that TikTok's own interface sits on top of once a video is posted: a thin top bar, a bottom band for the caption/username/sound title, and a right-hand column of like, comment, bookmark, share, and profile icons. Anything important placed there, a face, a subtitle, a product, gets partly or fully covered while someone is actually watching.",
	},
	{
		q: 'What size is TikTok\'s safe zone?',
		a: "At the standard 1080x1920 export, the bottom caption/username/sound band runs roughly 20% up from the base (about 384px), and the right-hand icon column eats roughly the last 14% of width (about 151px). This tool shows both bands drawn to scale on your own photo, plus the exact pixel and percent figures below the preview.",
	},
	{
		q: 'Is this safe zone measurement exact?',
		a: "It's a close approximation based on TikTok's published creator and ads specs, not a pixel-perfect measurement pulled from the live app. TikTok tweaks its UI over time, so treat this as a composition check, not a guarantee.",
	},
	{
		q: 'Does this tool upload my photo anywhere?',
		a: 'No. The image is drawn straight into an on-page canvas and never leaves your browser.',
	},
	{
		q: 'Can I check Instagram Reels too?',
		a: "Yes, Reels reserves similar but not identical space. Use the dedicated Instagram safe zone checker to overlay Reels', Stories', or feed Post's UI on your photo.",
	},
	{
		q: "What's TikTok's ideal video size and aspect ratio?",
		a: "1080x1920 pixels at a 9:16 aspect ratio is TikTok's standard export size for both organic posts and ads. This tool's frame matches that resolution, so the safe-zone measurements line up directly with whatever you export from your camera or editor.",
	},
	{
		q: 'Where should I put a face, subtitle, or logo to keep it visible?',
		a: "The center third of the frame, roughly the middle of the width and the area between the thin top bar and the bottom caption band, stays clear across devices. Keep faces and key text there rather than pinned to the very bottom or right edge.",
	},
	{
		q: "Does TikTok's safe zone apply to photo posts, not just video?",
		a: "Yes. TikTok photo posts (carousel slides) sit inside the same 9:16 frame and get the same caption, username, sound, and icon overlay as videos, so the same safe zone applies.",
	},
	{
		q: 'Is there a TikTok safe zone template I can use in CapCut or Premiere Pro?',
		a: 'Yes, see the dedicated TikTok safe zone template page for the exact pixel and percent breakdown plus step-by-step instructions for turning it into a guide layer in CapCut or Premiere Pro before you export.',
	},
];
---

<Layout {title} {description} {keywords} {path} structuredData={structuredData}>
	<Navbar variant="landing" />
	<main>
		<Breadcrumbs
			items={[
				{ label: 'Home', href: '/' },
				{ label: 'Tools' },
				{ label: 'TikTok Safe Zone' },
			]}
		/>

		<section class="mx-auto flex w-full max-w-3xl flex-col items-center px-4 pb-4 text-center sm:px-6">
			<span class="mb-4 font-mono text-xs tracking-wide text-mute">FREE TOOL</span>
			<h1 class="font-sans text-4xl font-semibold tracking-[-0.03em] text-ink sm:text-5xl">
				TikTok safe zone checker
			</h1>
			<p class="mt-5 max-w-xl text-base leading-7 text-body">
				Drop a photo onto a 9:16 frame to see where TikTok's caption, username, sound title, and
				engagement icons will sit on top of it, before you post.
			</p>
		</section>

		<SafeZoneTool platform="tiktok" />

		<section class="mx-auto w-full max-w-3xl px-4 py-14 sm:px-6">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">WHY IT MATTERS</span>
			<h2 class="font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">
				Composition that survives TikTok's own UI
			</h2>
			<div class="mt-6 flex flex-col gap-5 text-base leading-7 text-body">
				<p>
					A vertical frame that looks perfectly composed in a raw export can still lose its subject
					once TikTok lays a caption, a username, a sound title, and a column of like/comment/share
					icons on top of it. Checking against TikTok's safe zone before posting means a face, a
					subtitle, or a key product detail doesn't end up hidden behind the app's own chrome.
				</p>
				<p>
					TikTok reserves a thin top bar for Following/For You, a bottom band for caption, username,
					and sound, and a right-hand column for engagement icons. This tool overlays all three at
					the sizes TikTok's own creator specs publish, drawn straight onto your photo so you can see
					the effect on your actual composition.
				</p>
			</div>
		</section>

		<section class="mx-auto w-full max-w-3xl px-4 pb-14 sm:px-6">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">TIKTOK TEMPLATE APP</span>
			<h2 class="font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">
				A free tiktok template app, right in the browser
			</h2>
			<div class="mt-6 flex flex-col gap-5 text-base leading-7 text-body">
				<p>
					Searching for a tiktok template usually turns up a native app to download or a paid pack
					of tiktok template png files sized to some other creator's export settings. This checker
					works differently: it's a free tiktok template app that runs entirely in the browser, so
					instead of downloading a fixed tiktok safe zone png and hoping it lines up with your own
					footage, you drop your own photo or frame grab in and see the tiktok safe zone overlay
					drawn to scale on your actual composition.
				</p>
				<p>
					That makes it a template in the practical sense, a reusable, exact reference for where
					TikTok's UI sits, without being a static tiktok template png you'd otherwise need to
					re-download every time TikTok tweaks its layout. Need the same numbers as a downloadable
					reference for CapCut or Premiere Pro instead? The <a href="/tiktok-safe-zone-template/" class="text-ink underline decoration-hairline-strong underline-offset-2 hover:decoration-ink">TikTok safe zone template</a> page
					breaks this same tiktok template down into exact pixel and percent figures.
				</p>
			</div>
		</section>

		<section class="mx-auto w-full max-w-3xl px-4 pb-14 sm:px-6">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">GO DEEPER</span>
			<h2 class="font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">
				More tools for creators
			</h2>
			<div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
				<a href="/instagram-reels-safe-zone/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">Instagram Reels safe zone checker</span>
					<span class="mt-1 block font-mono text-xs text-mute">The same check, tuned to Reels' UI</span>
				</a>
				<a href="/tiktok-safe-zone-template/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">TikTok safe zone template</span>
					<span class="mt-1 block font-mono text-xs text-mute">Exact dimensions for CapCut & Premiere Pro</span>
				</a>
				<a href="/guides/social-media-safe-zones/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">Social media safe zone guide</span>
					<span class="mt-1 block font-mono text-xs text-mute">Every platform's dimensions, in one reference</span>
				</a>
				<a href="/for/instagram/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">Cinematic Instagram editor</span>
					<span class="mt-1 block font-mono text-xs text-mute">Presets plus 1:1 / 4:5 / 9:16 export crops</span>
				</a>
				<a href="/presets/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">Browse all 60 presets</span>
					<span class="mt-1 block font-mono text-xs text-mute">Every color grade, organized by genre</span>
				</a>
			</div>
		</section>

		<MovieFaq eyebrow="FAQ" heading="Common questions about TikTok's safe zone" faqs={faqs} />

		<script type="application/ld+json" set:html={JSON.stringify(howToStructuredData)} />
	</main>
	<Footer />
</Layout>
