---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import MovieFaq from '../../components/MovieFaq.astro';

const path = '/guides/social-media-safe-zones/';
const title = 'Social Media Safe Zone Guide: TikTok, Reels, Stories & Posts | Cinematic Photo';
const description =
	'Every major vertical-video safe zone in one reference: exact TikTok, Instagram Reels, Stories, and feed Post dimensions, plus design rules for keeping faces, text, and logos visible.';
const keywords =
	'social media safe zone, safe zone guide, tiktok safe zone dimensions, instagram safe zone dimensions, reels safe zone size, stories safe zone size, vertical video safe zone, 9:16 safe zone, instagram safe zone guide';

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: 'Social Media Safe Zone Guide: TikTok, Reels, Stories & Posts',
	description,
	url: `https://cinematicphoto.com${path}`,
	author: { '@type': 'Organization', name: 'Cinematic Photo' },
	publisher: { '@type': 'Organization', name: 'Cinematic Photo' },
	mainEntityOfPage: `https://cinematicphoto.com${path}`,
};

const platforms = [
	{
		name: 'TikTok',
		frame: '1080×1920 (9:16)',
		reserved: 'Top bar, bottom caption/username/sound band, right-hand icon rail',
		note: 'The right-hand icon rail is the one creators forget, it eats the last ~14% of width.',
	},
	{
		name: 'Instagram Reels',
		frame: '1080×1920 (9:16)',
		reserved: 'Top bar, bottom caption/username/audio band, right-hand icon rail',
		note: "Similar shape to TikTok's, but the bands sit at slightly different depths, don't reuse one composition for both without checking.",
	},
	{
		name: 'Instagram Stories',
		frame: '1080×1920 (9:16)',
		reserved: 'Top profile/timestamp bar, bottom reply-field row',
		note: 'No side icon rail here, the risk is the top and bottom, not the edges.',
	},
	{
		name: 'Instagram Post (feed grid)',
		frame: '1080×1350 (4:5)',
		reserved: 'Top ~10% and bottom ~10%, trimmed by the square profile-grid crop',
		note: "There's no app UI drawn over a Post, this is a crop check, not a UI-overlap check.",
	},
];

const faqs = [
	{
		q: 'Is there one safe zone that works for every platform?',
		a: "No. TikTok, Reels, and Stories are all 9:16, but their UI sits in different places, and a feed Post is a different aspect ratio (4:5) entirely with a crop-based risk instead of a UI-overlap one. Designing to the tightest common area across all of them, roughly the center third, horizontally and vertically, is the closest thing to a universal safe zone, but checking each platform individually catches more than that shortcut alone.",
	},
	{
		q: 'Do these dimensions ever change?',
		a: 'Yes, occasionally. TikTok, Instagram, and YouTube all tweak their in-app UI over time, shifting a caption band a few percent or adding a new button. The figures here are close approximations based on published creator and ads specs, treat them as a composition check rather than a pixel-exact guarantee, and re-check a template periodically rather than assuming it stays accurate forever.',
	},
	{
		q: "What's the fastest way to check a safe zone without exporting first?",
		a: "Drop the photo straight into a safe-zone checker and look at the overlay before you export anything. Cinematic Photo has a dedicated TikTok safe zone checker, an Instagram checker covering Reels, Stories, and Posts, and a combined tool that overlays TikTok and Reels together for a side-by-side comparison, all client-side, nothing gets uploaded.",
	},
	{
		q: 'Does a safe zone matter for a static photo the same way it does for video?',
		a: "Yes. A photo post, a Reels cover image, or a TikTok photo-mode slide all sit inside the same frame and get the same UI or crop treatment as a video would. If anything, it matters more for a photo, a video has motion and multiple frames to work with, a single still only gets one composition to get right.",
	},
	{
		q: 'What should I do if a face or logo has to sit near an edge?',
		a: "Where possible, reframe or re-crop so the important element sits inside the center third instead. When that's not possible, favor the top of the frame over the bottom, both TikTok's and Reels' heaviest UI (caption, username, icon rail) concentrates in the bottom two-thirds, so top placement tends to survive more platforms.",
	},
	{
		q: 'Are safe zones different for ads versus organic posts?',
		a: "Largely the same underlying frame and UI, but ads specs are usually the more conservative, well-documented source, since a brand can't afford a cropped logo. That's also why this guide, and the tools linked below, draw their figures from published creator and ads specs rather than guessing from screenshots.",
	},
];
---

<Layout {title} {description} {keywords} {path} structuredData={structuredData}>
	<Navbar variant="landing" />
	<main>
		<Breadcrumbs
			items={[
				{ label: 'Home', href: '/' },
				{ label: 'Guides' },
				{ label: 'Social Media Safe Zones' },
			]}
		/>

		<section class="mx-auto flex w-full max-w-3xl flex-col items-center px-4 pb-4 text-center sm:px-6">
			<span class="mb-4 font-mono text-xs tracking-wide text-mute">SAFE ZONE GUIDE</span>
			<h1 class="font-sans text-4xl font-semibold tracking-[-0.03em] text-ink sm:text-5xl">
				Social media safe zones, explained
			</h1>
			<p class="mt-5 max-w-xl text-base leading-7 text-body">
				TikTok, Instagram Reels, Stories, and feed Posts each hide a different slice of the frame
				behind their own UI or crop. Here's what's reserved where, and how to compose around it.
			</p>
		</section>

		<section class="mx-auto w-full max-w-3xl px-4 py-14 sm:px-6">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">THE REFERENCE</span>
			<h2 class="font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">
				What each platform reserves
			</h2>
			<div class="mt-6 overflow-x-auto">
				<table class="w-full min-w-[560px] border-collapse text-left">
					<thead>
						<tr class="border-b border-hairline">
							<th class="py-2.5 pr-4 font-mono text-[11px] font-medium tracking-wide text-mute uppercase">Platform</th>
							<th class="py-2.5 pr-4 font-mono text-[11px] font-medium tracking-wide text-mute uppercase">Frame</th>
							<th class="py-2.5 pr-4 font-mono text-[11px] font-medium tracking-wide text-mute uppercase">Reserved space</th>
						</tr>
					</thead>
					<tbody>
						{
							platforms.map((p) => (
								<tr class="border-b border-hairline align-top">
									<td class="py-3 pr-4 font-sans text-sm font-medium whitespace-nowrap text-ink">{p.name}</td>
									<td class="py-3 pr-4 font-mono text-xs whitespace-nowrap text-mute">{p.frame}</td>
									<td class="py-3 pr-4 text-sm leading-6 text-body">
										{p.reserved}
										<span class="mt-1 block text-xs text-mute">{p.note}</span>
									</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
			<p class="mt-4 text-sm leading-6 text-mute">
				These are close approximations of each platform's published creator and ads specs, not
				pixel-exact measurements. Use the interactive checkers linked below to overlay the exact
				bands on your own photo.
			</p>
		</section>

		<section class="mx-auto w-full max-w-3xl px-4 pb-14 sm:px-6">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">DESIGN RULES</span>
			<h2 class="font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">
				Composing so nothing important gets covered
			</h2>
			<div class="mt-6 flex flex-col gap-6 text-base leading-7 text-body">
				<div>
					<h3 class="font-sans text-lg font-semibold text-ink">Keep the subject in the center third</h3>
					<p class="mt-2">
						Across TikTok, Reels, and Stories, the safest region is roughly the middle third of the
						frame, both horizontally and vertically. It sits clear of every top bar, bottom caption
						band, and side icon rail across all three platforms at once, which makes it the default
						spot for a face, a subtitle, or a product detail.
					</p>
				</div>
				<div>
					<h3 class="font-sans text-lg font-semibold text-ink">Design for the tightest platform, not the loosest</h3>
					<p class="mt-2">
						If a photo needs to work across TikTok, Reels, and Stories at once, compose it against
						whichever platform reserves the most space in that direction, TikTok's bottom band and
						icon rail are both slightly larger than Reels', so a composition that clears TikTok
						clears Reels too. Checking the loosest platform first is how a caption ends up clipped
						somewhere you didn't test.
					</p>
				</div>
				<div>
					<h3 class="font-sans text-lg font-semibold text-ink">A feed Post is a crop problem, not a UI problem</h3>
					<p class="mt-2">
						Nothing is drawn on top of a Post, so the risk isn't an icon covering a face, it's the
						profile grid's square crop trimming the top and bottom of a 4:5 image. Keep the subject
						vertically centered within the middle square rather than letting it run to the top or
						bottom edge of the full 4:5 frame.
					</p>
				</div>
				<div>
					<h3 class="font-sans text-lg font-semibold text-ink">Check before exporting, not after</h3>
					<p class="mt-2">
						Re-cropping a photo after it's already graded, captioned, or exported is slower and
						often degrades quality. Overlaying the safe zone on the original photo first, before any
						other editing, catches a bad composition while it's still cheap to fix.
					</p>
				</div>
			</div>
		</section>

		<section class="mx-auto w-full max-w-3xl px-4 pb-14 sm:px-6">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">GO DEEPER</span>
			<h2 class="font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">
				Check your own photo
			</h2>
			<div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
				<a href="/tiktok-safe-zone/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">TikTok safe zone checker</span>
					<span class="mt-1 block font-mono text-xs text-mute">Overlay TikTok's UI on your photo</span>
				</a>
				<a href="/tiktok-safe-zone-template/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">TikTok safe zone template</span>
					<span class="mt-1 block font-mono text-xs text-mute">Dimensions for CapCut & Premiere Pro</span>
				</a>
				<a href="/instagram-reels-safe-zone/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">Instagram safe zone checker</span>
					<span class="mt-1 block font-mono text-xs text-mute">Reels, Post, and Stories in one tool</span>
				</a>
				<a href="/instagram-safe-zone-template/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">Instagram safe zone template</span>
					<span class="mt-1 block font-mono text-xs text-mute">Dimensions for Reels, Story & Post</span>
				</a>
				<a href="/tools/safe-zones/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">Compare TikTok vs. Reels</span>
					<span class="mt-1 block font-mono text-xs text-mute">Toggle both platforms' overlays at once</span>
				</a>
				<a href="/for/instagram/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">Cinematic Instagram editor</span>
					<span class="mt-1 block font-mono text-xs text-mute">Presets plus 1:1 / 4:5 / 9:16 export crops</span>
				</a>
			</div>
		</section>

		<MovieFaq eyebrow="FAQ" heading="Common questions about social media safe zones" faqs={faqs} />
	</main>
	<Footer />
</Layout>
