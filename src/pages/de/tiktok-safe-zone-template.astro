---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import MovieFaq from '../../components/MovieFaq.astro';
import { getSafeZonePlatform, getZoneMetric } from '../../lib/safeZones';

const path = '/tiktok-safe-zone-template/';
const title = 'TikTok Safe Zone Vorlage (2026) | PNG-Guide für CapCut & Premiere Pro';
const description =
	"Die TikTok-Safe-Zone-Vorlage für 2026: exakte Maße für obere Leiste, Caption/Benutzername/Sound und Icon-Leiste in Pixel und Prozent, plus Anleitung für eine Safe-Zone-Hilfsebene in CapCut oder Premiere Pro vor dem Export.";
const keywords =
	'tiktok vorlage, tiktok template png, tiktok template app, tiktok safe zone vorlage, tiktok safe zone png, tiktok safe zone overlay, tiktok safe zone 2026, tiktok safe zone vorlage capcut, capcut tiktok safe zone, tiktok safe zone vorlage premiere pro, tiktok safe zones organisch, tiktok safe zone maße';

const tiktok = getSafeZonePlatform('tiktok');
const [topBar, captionBand, iconRail] = tiktok.zones;
const topMetric = getZoneMetric(topBar, tiktok.frame);
const captionMetric = getZoneMetric(captionBand, tiktok.frame);
const iconMetric = getZoneMetric(iconRail, tiktok.frame);

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: 'TikTok Safe Zone Vorlage (2026): Exakte Maße für CapCut & Premiere Pro',
	description,
	url: `https://cinematicphoto.com${path}`,
	author: { '@type': 'Organization', name: 'Cinematic Photo' },
	publisher: { '@type': 'Organization', name: 'Cinematic Photo' },
	mainEntityOfPage: `https://cinematicphoto.com${path}`,
};

const howToStructuredData = {
	'@context': 'https://schema.org',
	'@type': 'HowTo',
	name: 'So fügst du eine TikTok-Safe-Zone-Hilfe in CapCut oder Premiere Pro hinzu',
	description:
		"Baue eine TikTok-Safe-Zone-Referenzebene in deinem Editor, damit Captions, Gesichter und Logos nie unter TikToks eigener Oberfläche landen.",
	step: [
		{
			'@type': 'HowToStep',
			name: 'Referenz-PNG erzeugen',
			text: "Leg ein Frame aus deinem Schnitt in den kostenlosen TikTok-Safe-Zone-Checker und exportiere das Referenz-PNG, das genau zeigt, wo TikToks Oberfläche sitzen wird.",
		},
		{
			'@type': 'HowToStep',
			name: 'Als Overlay oder oberste Spur hinzufügen',
			text: "In CapCut fügst du es über Overlay hinzu; in Premiere Pro platzierst du es auf einer Videospur über deinem Hauptmaterial.",
		},
		{
			'@type': 'HowToStep',
			name: 'Deckkraft verringern',
			text: 'Reduziere die Deckkraft der Ebene auf etwa 30 bis 40%, damit sie als Hilfe und nicht als eingebrannte Grafik wirkt, und skaliere sie auf den vollen 1080x1920-Rahmen.',
		},
		{
			'@type': 'HowToStep',
			name: 'Vor dem Export ausblenden oder löschen',
			text: 'Schalte das Overlay bzw. die Spur aus, oder lösche die Ebene, sobald deine Komposition die Safe Zone einhält, damit sie nie im finalen Export landet.',
		},
	],
};

const faqs = [
	{
		q: 'Was ist eine Vorlage auf TikTok?',
		a: "Auf dieser Seite ist eine TikTok-Vorlage die exakten Maße für obere Leiste, Caption/Benutzername/Sound und Icon-Leiste, die TikTok für seine eigene Oberfläche reserviert, in Pixel und Prozent, so aufbereitet, dass daraus eine Hilfsebene in einem Editor werden kann. Es ist eine Kompositions-Referenz, keine Design-Vorlage mit fertigem Text oder Grafiken, ihr ganzer Zweck ist zu zeigen, wo TikToks eigene Oberfläche einen Teil des Rahmens verdeckt, damit dort nichts Wichtiges aus Versehen platziert wird.",
	},
	{
		q: 'Gibt es ein herunterladbares TikTok-Safe-Zone-Vorlage-PNG?',
		a: "Ein eigenes transparentes Overlay-PNG-Paket ist in Arbeit und noch nicht verfügbar. In der Zwischenzeit zeichnet der kostenlose interaktive Checker unten die exakte Safe Zone bereits maßstabsgetreu auf dein eigenes Foto oder deinen Frame-Grab und lässt dich ein Referenz-PNG als Platzierungshilfe während des Schnitts exportieren.",
	},
	{
		q: "Hat sich TikToks Safe Zone für 2026 geändert?",
		a: "Die Maße auf dieser Seite spiegeln TikToks aktuell veröffentlichte Creator- und Ads-Spezifikationen wider. TikTok passt seine Oberfläche gelegentlich an (eine breitere Icon-Leiste, ein höheres Caption-Band), diese Vorlage wird deshalb regelmäßig gegen die Live-App geprüft statt statisch zu bleiben. Behandle jede Safe-Zone-Vorlage, auch diese hier, als enge Annäherung und nicht als dauerhaft pixelgenaue Spezifikation.",
	},
	{
		q: 'Wie füge ich eine TikTok-Safe-Zone-Vorlage in CapCut hinzu?',
		a: "Importiere das Referenz-PNG und nutze dann CapCuts Overlay-Funktion, um es über deine Haupt-Timeline zu legen. Skaliere es auf den vollen Rahmen, senke die Deckkraft, damit du dein Material darunter noch siehst, und lass es während des Schnitts auf der obersten Ebene. Lösche oder blende den Overlay-Clip vor deinem finalen Export aus, damit er nicht ins Video gerendert wird.",
	},
	{
		q: 'Wie füge ich eine TikTok-Safe-Zone-Vorlage in Premiere Pro hinzu?',
		a: "Importiere das Referenz-PNG als Clip und platziere es auf einer Videospur über deinem Material (z. B. V2 über V1). Wähle den Clip aus, öffne Effekteinstellungen und senke die Deckkraft auf etwa 30 bis 40%. Premieres eingebautes Sicherheitsbereich-Overlay (das Schraubenschlüssel-Symbol am Programm-Monitor) zeigt eine generische Aktions-/Titel-Sicherheitshilfe, ist aber nicht auf TikToks Oberfläche zugeschnitten, ein importiertes PNG ist deshalb die genauere Variante. Schalte die Sichtbarkeit der Spur (das Augen-Symbol) vor dem Export aus.",
	},
	{
		q: 'Sind organische TikTok-Safe-Zones dieselben wie TikTok-Ads-Safe-Zones?',
		a: "Größtenteils derselbe zugrunde liegende 1080x1920-Rahmen und dieselbe Oberflächen-Platzierung, aber die Ads-Spezifikationen sind die konservativere, besser dokumentierte Quelle, weil eine Marke sich kein abgeschnittenes Logo oder keine abgeschnittene CTA leisten kann. Für organische Posts gelten in der Praxis dieselben Werte: Das Caption-/Benutzername-/Sound-Band und die Icon-Leiste decken denselben Bereich ab, egal ob ein Video beworben oder kostenlos gepostet wird, also funktioniert eine Vorlage für beides.",
	},
	{
		q: 'Funktioniert das auch für Instagram?',
		a: "TikTok und Instagram Reels reservieren ähnlichen, aber nicht identischen Platz. Sieh dir für die exakten Reels-, Story- und Post-Maße die eigene Seite zur Instagram-Safe-Zone-Vorlage an, statt TikToks Werte wiederzuverwenden.",
	},
];
---

<Layout {title} {description} {keywords} {path} structuredData={structuredData}>
	<Navbar variant="landing" />
	<main>
		<Breadcrumbs
			items={[
				{ label: 'Startseite', href: '/de/' },
				{ label: 'Anleitungen' },
				{ label: 'TikTok Safe Zone Vorlage' },
			]}
		/>

		<section class="mx-auto flex w-full max-w-3xl flex-col items-center px-4 pb-4 text-center sm:px-6">
			<span class="mb-4 font-mono text-xs tracking-wide text-mute">VORLAGE 2026</span>
			<h1 class="font-sans text-4xl font-semibold tracking-[-0.03em] text-ink sm:text-5xl">
				TikTok-Safe-Zone-Vorlage
			</h1>
			<p class="mt-5 max-w-xl text-base leading-7 text-body">
				Die exakten 1080x1920-Maße, die TikTok für seine eigene Oberfläche reserviert, plus
				Anleitung, wie du daraus vor dem Export eine Hilfsebene in CapCut oder Premiere Pro machst.
			</p>
		</section>

		<section class="mx-auto w-full max-w-3xl px-4 py-14 sm:px-6">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">DIE VORLAGE</span>
			<h2 class="font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">
				TikToks Safe Zone, in Pixel und Prozent
			</h2>
			<div class="mt-6 overflow-x-auto">
				<table class="w-full min-w-[520px] border-collapse text-left">
					<thead>
						<tr class="border-b border-hairline">
							<th class="py-2.5 pr-4 font-mono text-[11px] font-medium tracking-wide text-mute uppercase">Zone</th>
							<th class="py-2.5 pr-4 font-mono text-[11px] font-medium tracking-wide text-mute uppercase">Tiefe</th>
							<th class="py-2.5 pr-4 font-mono text-[11px] font-medium tracking-wide text-mute uppercase">Position</th>
						</tr>
					</thead>
					<tbody>
						<tr class="border-b border-hairline align-top">
							<td class="py-3 pr-4 font-sans text-sm font-medium whitespace-nowrap text-ink">Obere Leiste</td>
							<td class="py-3 pr-4 font-mono text-xs whitespace-nowrap text-mute">{topMetric.px}px ({topMetric.percent}%)</td>
							<td class="py-3 pr-4 text-sm leading-6 text-body">Following-/For-You-Umschalter, volle Breite, an der oberen Kante fixiert</td>
						</tr>
						<tr class="border-b border-hairline align-top">
							<td class="py-3 pr-4 font-sans text-sm font-medium whitespace-nowrap text-ink">Caption, Benutzername, Sound</td>
							<td class="py-3 pr-4 font-mono text-xs whitespace-nowrap text-mute">{captionMetric.px}px ({captionMetric.percent}%)</td>
							<td class="py-3 pr-4 text-sm leading-6 text-body">Unteres Band, ungefähr das letzte Fünftel der Rahmenhöhe</td>
						</tr>
						<tr class="border-b border-hairline align-top">
							<td class="py-3 pr-4 font-sans text-sm font-medium whitespace-nowrap text-ink">Like, Kommentar, Speichern, Teilen, Profil</td>
							<td class="py-3 pr-4 font-mono text-xs whitespace-nowrap text-mute">{iconMetric.px}px ({iconMetric.percent}%)</td>
							<td class="py-3 pr-4 text-sm leading-6 text-body">Rechte Spalte, ungefähr das letzte Siebtel der Rahmenbreite</td>
						</tr>
					</tbody>
				</table>
			</div>
			<p class="mt-4 text-sm leading-6 text-mute">
				Die Werte gelten für TikToks Standard-Exportgröße von {tiktok.frame.width}x{tiktok.frame.height} (9:16) und
				für organische Posts sowie Ads gleichermaßen. Enge Annäherungen basierend auf TikToks
				veröffentlichten Spezifikationen, keine pixelgenauen Messungen aus der Live-App.
			</p>
		</section>

		<section class="mx-auto w-full max-w-3xl px-4 pb-14 sm:px-6">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">DIE VORLAGE NUTZEN</span>
			<h2 class="font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">
				So wird daraus eine Hilfsebene in deinem Editor
			</h2>
			<div class="mt-6 flex flex-col gap-6 text-base leading-7 text-body">
				<div>
					<h3 class="font-sans text-lg font-semibold text-ink">CapCut</h3>
					<p class="mt-2">
						Erzeuge mit dem Checker unten ein Referenz-PNG und füge es dann über CapCuts
						Overlay-Funktion hinzu, sodass es auf einer Ebene über deinem Hauptmaterial sitzt.
						Skaliere es auf den vollen Rahmen, senke die Deckkraft auf etwa 30 bis 40% und lass es
						oben, während du Captions, Gesichter und Logos platzierst. Lösche oder blende den
						Overlay-Clip vor deinem finalen Export aus, damit er nie ins Video gerendert wird.
					</p>
				</div>
				<div>
					<h3 class="font-sans text-lg font-semibold text-ink">Premiere Pro</h3>
					<p class="mt-2">
						Importiere das Referenz-PNG als Clip und platziere es auf einer Spur über deinem
						Material. Wähle es aus, öffne Effekteinstellungen und senke die Deckkraft auf etwa
						30 bis 40%. Premieres eingebautes Sicherheitsbereich-Overlay (das
						Schraubenschlüssel-Symbol am Programm-Monitor) zeigt eine generische
						Aktions-/Titel-Sicherheitshilfe, ist aber nicht auf TikToks Oberfläche zugeschnitten,
						ein importiertes PNG passend zur Tabelle oben ist deshalb die genauere Variante. Schalte
						die Sichtbarkeit der Spur vor dem Export aus.
					</p>
				</div>
			</div>
		</section>

		<section class="mx-auto w-full max-w-3xl px-4 pb-14 sm:px-6">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">DEINE EIGENE ERZEUGEN</span>
			<h2 class="font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">
				Erst an deinem eigenen Foto prüfen
			</h2>
			<p class="mt-4 text-base leading-7 text-body">
				Bevor du eine Hilfsebene von Hand baust, leg einen Frame-Grab oder ein Thumbnail in den
				interaktiven Checker, um diese Zonen maßstabsgetreu auf deiner tatsächlichen Komposition zu
				sehen, und exportiere direkt daraus ein Referenz-PNG.
			</p>
			<a
				href="/de/tiktok-safe-zone/"
				class="mt-6 inline-block rounded-md bg-primary px-5 py-2.5 font-sans text-sm font-medium text-on-primary transition-opacity hover:opacity-90"
			>
				TikTok-Safe-Zone-Checker öffnen →
			</a>
		</section>

		<section class="mx-auto w-full max-w-3xl px-4 pb-14 sm:px-6">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">TIKTOK-VORLAGE, KEIN APP-DOWNLOAD</span>
			<h2 class="font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">
				Warum diese TikTok-Vorlage besser ist als ein statisches PNG-Paket
			</h2>
			<div class="mt-6 flex flex-col gap-5 text-base leading-7 text-body">
				<p>
					Die meisten Suchen nach einer TikTok-Vorlage führen entweder zu einer TikTok-Vorlage-App
					zum Installieren oder einem kostenpflichtigen TikTok-Vorlage-PNG-Paket, das einmal
					gemessen und nie wieder geprüft wurde. Beides veraltet, sobald TikTok seine Oberfläche
					anpasst. Die Tabelle oben ist dieselbe TikTok-Vorlage, aktuell gehalten und gepaart mit
					dem interaktiven Checker, sodass es nie nur ein flaches TikTok-Safe-Zone-Overlay zum
					Abschätzen ist, sondern maßstabsgetreu auf dein eigenes Material gezeichnet wird.
				</p>
				<p>
					Wenn du speziell ein herunterladbares TikTok-Safe-Zone-PNG für eine Hilfsebene brauchst,
					exportiere eines direkt aus dem Checker unten statt aus einem generischen Paket: Es
					passt zu den Maßen deines eigenen Rahmens statt zu einem Durchschnitt, den jemand anderes
					gemessen hat.
				</p>
			</div>
		</section>

		<section class="mx-auto w-full max-w-3xl px-4 pb-14 sm:px-6">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">TIEFER EINSTEIGEN</span>
			<h2 class="font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">
				Weitere Safe-Zone-Tools
			</h2>
			<div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
				<a href="/de/tiktok-safe-zone/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">TikTok-Safe-Zone-Checker</span>
					<span class="mt-1 block font-mono text-xs text-mute">Leg die Vorlage über dein eigenes Foto</span>
				</a>
				<a href="/de/instagram-safe-zone-template/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">Instagram-Safe-Zone-Vorlage</span>
					<span class="mt-1 block font-mono text-xs text-mute">Maße für Reels, Story & Post</span>
				</a>
				<a href="/de/instagram-reels-safe-zone/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">Instagram-Reels-Safe-Zone-Checker</span>
					<span class="mt-1 block font-mono text-xs text-mute">Derselbe Check, abgestimmt auf Reels' Oberfläche</span>
				</a>
				<a href="/de/guides/social-media-safe-zones/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">Social-Media-Safe-Zone-Anleitung</span>
					<span class="mt-1 block font-mono text-xs text-mute">Die Maße jeder Plattform, an einem Ort</span>
				</a>
			</div>
		</section>

		<MovieFaq eyebrow="FAQ" heading="Häufige Fragen zur TikTok-Safe-Zone-Vorlage" faqs={faqs} />

		<script type="application/ld+json" set:html={JSON.stringify(howToStructuredData)} />
	</main>
	<Footer />
</Layout>
