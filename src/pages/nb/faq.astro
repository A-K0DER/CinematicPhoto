---
// The FAQ entries themselves still come from the shared English src/data/faqs.ts,
// that dataset is not localized yet. Only the page chrome is translated.
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import MovieFaq from '../../components/MovieFaq.astro';
import { ALL_FAQS } from '../../data/faqs';

const path = '/faq/';
const title = `Ofte stilte spørsmål | Cinematic Photo Editor`;
const description =
	'Alle spørsmål om Cinematic Photo besvart på ett sted: pris, personvern, støttede formater, og hvordan du får bestemte film- og serie-fargekorreksjoner.';
---

<Layout {title} {description} {path}>
	<Navbar variant="landing" />
	<main>
		<Breadcrumbs items={[{ label: 'Hjem', href: '/nb/' }, { label: 'FAQ' }]} />

		<section class="mx-auto flex w-full max-w-3xl flex-col items-center px-4 pb-4 text-center sm:px-6">
			<span class="mb-4 font-mono text-xs tracking-wide text-mute">HJELP</span>
			<h1 class="font-sans text-4xl font-semibold tracking-[-0.03em] text-ink sm:text-5xl">
				Ofte stilte spørsmål
			</h1>
			<p class="mt-5 max-w-xl text-base leading-7 text-body">
				Alle spørsmål om pris, personvern, støttede formater og bestemte film- eller
				serie-fargekorreksjoner, samlet på ett sted.
			</p>
		</section>

		<MovieFaq eyebrow={`ALLE ${ALL_FAQS.length} SPØRSMÅL`} heading="Alt du kanskje lurer på" faqs={ALL_FAQS} />
	</main>
	<Footer />
</Layout>
