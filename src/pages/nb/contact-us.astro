---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const title = 'Kontakt oss | Cinematic Photo Editor';
const description = 'Ta kontakt med Cinematic Photo-teamet for support, tilbakemeldinger, presetønsker eller presseforespørsler om vår gratis nettbaserte cinematiske fotoeditor.';
---

<Layout title={title} description={description} path="/contact-us/">
	<Navbar />
	<main class="mx-auto max-w-3xl px-4 py-20 sm:px-6">
		<span class="mb-4 block font-mono text-xs tracking-wide text-mute">KONTAKT OSS</span>
		<h1 class="font-sans text-3xl font-semibold tracking-[-0.03em] text-ink sm:text-4xl">
			Vi vil gjerne høre fra deg
		</h1>

		<div class="mt-8 flex flex-col gap-6 text-base leading-7 text-body">
			<p>
				Enten du har funnet en feil, ønsker deg en ny fargekorreksjon som preset, eller har en
				presse- eller samarbeidsforespørsel, send oss en melding under, så tar vi kontakt.
			</p>

			<form
				id="contact-form"
				action="https://formspree.io/f/xoeadery"
				method="POST"
				class="flex flex-col gap-4 rounded-xl border border-hairline bg-canvas-soft p-6"
			>
				<div class="flex flex-col gap-1.5">
					<label for="name" class="font-mono text-xs tracking-wide text-mute">NAVN</label>
					<input
						id="name"
						name="name"
						type="text"
						required
						class="rounded-md border border-hairline bg-canvas px-3 py-2 font-sans text-sm text-ink outline-none placeholder:text-mute focus:border-hairline-strong"
						placeholder="Ditt navn"
					/>
				</div>

				<div class="flex flex-col gap-1.5">
					<label for="email" class="font-mono text-xs tracking-wide text-mute">E-POST</label>
					<input
						id="email"
						name="email"
						type="email"
						required
						class="rounded-md border border-hairline bg-canvas px-3 py-2 font-sans text-sm text-ink outline-none placeholder:text-mute focus:border-hairline-strong"
						placeholder="deg@eksempel.no"
					/>
				</div>

				<div class="flex flex-col gap-1.5">
					<label for="message" class="font-mono text-xs tracking-wide text-mute">MELDING</label>
					<textarea
						id="message"
						name="message"
						rows="5"
						required
						class="resize-none rounded-md border border-hairline bg-canvas px-3 py-2 font-sans text-sm text-ink outline-none placeholder:text-mute focus:border-hairline-strong"
						placeholder="Hvordan kan vi hjelpe?"
					></textarea>
				</div>

				<button
					type="submit"
					class="mt-2 self-start rounded-md bg-primary px-4 py-2 font-sans text-sm font-medium text-on-primary transition-opacity hover:opacity-90 disabled:opacity-60"
				>
					Send melding
				</button>
				<p id="form-error" class="hidden font-sans text-sm text-red-500">
					Noe gikk galt under sending av meldingen din. Prøv igjen.
				</p>
			</form>

			<h2 class="font-sans text-xl font-semibold tracking-[-0.02em] text-ink">Support</h2>
			<p>
				Siden Cinematic Photo behandler hvert bilde lokalt i nettleseren din, er de fleste
				problemer knyttet til en bestemt nettleser, filtype eller enhet. Når du melder fra om et
				problem, hjelper det å oppgi nettleser og versjon, bildeformatet du brukte, og en
				beskrivelse av hva du forventet sammenlignet med hva som faktisk skjedde.
			</p>

			<h2 class="font-sans text-xl font-semibold tracking-[-0.02em] text-ink">Tilbakemeldinger og presetønsker</h2>
			<p>
				Hvis det er en filmfargekorreksjon du gjerne vil se lagt til, fortell oss hvilken film
				og, hvis mulig, et referansebilde eller en scene. Presetønsker former direkte hva vi
				bygger videre.
			</p>
		</div>
	</main>
	<Footer />
</Layout>

<script>
	const form = document.getElementById('contact-form') as HTMLFormElement;
	const errorMessage = document.getElementById('form-error');
	const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement;

	form.addEventListener('submit', async (event) => {
		event.preventDefault();
		errorMessage?.classList.add('hidden');
		submitButton.disabled = true;

		try {
			const response = await fetch(form.action, {
				method: form.method,
				body: new FormData(form),
				headers: { Accept: 'application/json' },
			});

			if (response.ok) {
				window.location.href = '/nb/thank-you/';
				return;
			}

			errorMessage?.classList.remove('hidden');
		} catch {
			errorMessage?.classList.remove('hidden');
		} finally {
			submitButton.disabled = false;
		}
	});
</script>
