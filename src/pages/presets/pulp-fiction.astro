---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import DropZone from '../../components/DropZone.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import RelatedPresets from '../../components/RelatedPresets.astro';
import MovieFaq from '../../components/MovieFaq.astro';
import { getPreset } from '../../lib/presets';

const preset = getPreset('pulp-fiction');
const path = '/presets/pulp-fiction/';

const title = 'Pulp Fiction Photo Filter & Editor | Free Cinematic Tool';
const description =
	"Use this free Pulp Fiction photo filter and photo editor to grade your photo with the film's pulpy amber-red, retro diner tone, instantly in your browser — no account needed.";
const keywords =
	'pulp fiction photo filter, pulp fiction photo editor, pulp fiction editor, pulp fiction color grade, retro photo filter';

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	name: title,
	description,
	url: `https://cinematicphoto.com${path}`,
	isPartOf: { '@type': 'WebSite', name: 'Cinematic Photo', url: 'https://cinematicphoto.com' },
};

const faqs = [
	{
		q: 'Is this an official Pulp Fiction photo filter?',
		a: "No. This preset is inspired by the visual aesthetic of Pulp Fiction's cinematography, it isn't an official filter licensed by or affiliated with Miramax or the film's creators. It's an independent color grade built to echo the look, not a branded tie-in product.",
	},
	{
		q: 'Is there a dedicated Pulp Fiction photo editor?',
		a: "This page is that dedicated editor — the Pulp Fiction grade loads pre-selected in the drop zone above, so you can drop a photo and immediately adjust its grain, vignette, and glow without hunting through the full 60-preset library first.",
	},
	{
		q: 'Why does the Pulp Fiction preset push saturation up instead of desaturating like most crime-film grades?',
		a: "Cinematographer Andrzej Sekuła leaned into rich, saturated color rather than the desaturated, gritty look common to crime cinema, echoing pulp novel covers and neon-lit diner culture. This preset pushes saturation harder than almost any other preset in this tool to chase that same pulpy, retro punch.",
	},
	{
		q: 'How is Pulp Fiction different from the Joker preset?',
		a: "Both are crime-adjacent grades with warm tones, but they split in saturation and mood. Pulp Fiction pushes color vividly, amber-red and warm, closer to retro neon than realism. Joker desaturates and grimes the image down, chasing a grittier, more unsettling 1970s aesthetic rather than Pulp Fiction's stylized pop.",
	},
	{
		q: 'Does the Pulp Fiction preset work on daylight photos?',
		a: "Yes. The grade is a warm, saturated color and contrast shift rather than a night-specific effect, so it reads well in daylight or indoor scenes alike, especially anything with some existing warmth: diner interiors, neon signage, sunset light.",
	},
	{
		q: 'Why does this preset add sepia on top of an already saturated base?',
		a: "The sepia layer keeps the elevated saturation from tipping into a garish, oversaturated look, grounding the vivid color in a warm, slightly aged tone that reads as stylized retro rather than an unfiltered digital color boost.",
	},
	{
		q: 'What kind of photos look best with a Pulp Fiction-style color grade?',
		a: 'Diners, retro interiors, neon signage, and cars all suit the grade especially well, since they carry the warm, saturated color the palette is built to amplify. Portraits under warm ambient or neon light also hold up strongly.',
	},
];
---

<Layout {title} {description} {keywords} {path} structuredData={structuredData}>
	<Navbar variant="landing" />
	<main>
		<Breadcrumbs
			items={[
				{ label: 'Home', href: '/' },
				{ label: 'All Presets', href: '/presets/' },
				{ label: 'Pulp Fiction' },
			]}
		/>

		<DropZone presetId={preset.id} showHeading={false} showFooterLinks={false} />

		<section class="mx-auto flex w-full max-w-3xl flex-col items-center px-4 pb-4 text-center sm:px-6">
			<span class="mb-4 font-mono text-xs tracking-wide text-mute">MOVIE-INSPIRED PRESET</span>
			<h1 class="font-sans text-4xl font-semibold tracking-[-0.03em] text-ink sm:text-5xl">
				The Pulp Fiction photo filter: pulpy amber-red, retro diner glow.
			</h1>
			<p class="mt-5 max-w-xl text-base leading-7 text-body">
				A free Pulp Fiction photo editor and color grading preset inspired by the visual aesthetic
				of Quentin Tarantino's Pulp Fiction, built to give photos the film's vivid, saturated,
				pulp-novel color without touching a curves panel.
			</p>
		</section>

		<section class="mx-auto w-full max-w-3xl px-4 py-14 sm:px-6">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">THE AESTHETIC</span>
			<h2 class="font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">
				Crime cinema, pulp-novel color
			</h2>
			<div class="mt-6 flex flex-col gap-5 text-base leading-7 text-body">
				<p>
					Cinematographer Andrzej Sekuła gave Pulp Fiction a look that broke from crime cinema's
					usual desaturated grit: rich, saturated amber and red tones borrowed from pulp paperback
					covers and mid-century diner culture. Jack Rabbit Slim's neon, sunlit LA streets, and
					warm apartment interiors all lean into that same vivid, stylized warmth rather than a
					muted, realist palette.
				</p>
				<p>
					It's color as attitude: confident, a little garish, unapologetically pop. That saturated
					punch is tempered just enough by a warm sepia undertone to keep the image feeling like
					stylized film rather than an oversaturated digital boost.
				</p>
			</div>
		</section>

		<section class="mx-auto w-full max-w-3xl px-4 pb-14 sm:px-6">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">BEFORE / AFTER</span>
			<h2 class="mb-6 font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">
				See the grade applied
			</h2>
			<BeforeAfter preset={preset} />
		</section>

		<section class="mx-auto w-full max-w-3xl px-4 pb-14 sm:px-6">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">THE COLOR SCIENCE</span>
			<h2 class="font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">
				How the Pulp Fiction color grade actually works
			</h2>
			<div class="mt-6 flex flex-col gap-5 text-base leading-7 text-body">
				<p>
					The base adjustment pushes saturation harder than almost any other preset in this tool,
					paired with elevated contrast and a warm sepia layer to keep that saturation grounded
					rather than garish. An amber-red overlay then sits across the frame in overlay blend
					mode, deepening warm tones in both shadows and highlights for a rich, retro-pulp cast.
				</p>
				<p>
					Grain and glow both run moderate to elevated, giving bright highlights, neon signage,
					sunlit windows, a soft, stylized bloom, while vignette stays restrained enough to keep
					the frame feeling open rather than closing in like a darker noir grade would.
				</p>
			</div>
		</section>

		<section class="mx-auto w-full max-w-3xl px-4 pb-14 sm:px-6">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">BEST PHOTOS FOR THIS PRESET</span>
			<h2 class="font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">
				What to shoot it on
			</h2>
			<ul class="mt-6 flex flex-col gap-4 text-base leading-7 text-body">
				<li class="flex gap-3">
					<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-mute"></span>
					<span><span class="font-medium text-ink">Diners, retro interiors, and neon signage.</span> Warm, saturated practical light is exactly what this grade's amber-red overlay is built to amplify.</span>
				</li>
				<li class="flex gap-3">
					<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-mute"></span>
					<span><span class="font-medium text-ink">Cars and roadside scenes.</span> The film's road-trip visual language translates directly, especially under warm daylight.</span>
				</li>
				<li class="flex gap-3">
					<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-mute"></span>
					<span><span class="font-medium text-ink">Portraits under warm ambient light.</span> Incandescent bulbs, neon, or golden-hour sun push the grade's saturated, stylized punch further.</span>
				</li>
			</ul>
		</section>

		<RelatedPresets
			heading="More movie-inspired grades"
			items={[
				{ presetId: 'joker', href: '/presets/joker/' },
				{ presetId: 'django-unchained', href: '/?preset=django-unchained' },
				{ presetId: 'goodfellas', href: '/?preset=goodfellas' },
				{ presetId: 'the-departed', href: '/?preset=the-departed' },
				{ presetId: 'kill-bill', href: '/?preset=kill-bill' },
			]}
		/>

		<MovieFaq
			eyebrow="PULP FICTION FAQ"
			heading="Common questions about the Pulp Fiction photo filter"
			faqs={faqs}
		/>

		<section class="mx-auto w-full max-w-3xl px-4 py-14 text-center sm:px-6">
			<p class="text-base leading-7 text-body">
				Prefer a different film's look? Browse the <a href="/presets/" class="text-ink underline decoration-hairline-strong underline-offset-2 hover:decoration-ink">full library of 60 presets</a>,
				learn more about <a href="/guides/cinematic-color-grading/" class="text-ink underline decoration-hairline-strong underline-offset-2 hover:decoration-ink">cinematic color grading</a>,
				or head to the <a href="/" class="text-ink underline decoration-hairline-strong underline-offset-2 hover:decoration-ink">homepage</a> to start with a blank slate.
			</p>
		</section>
	</main>
	<Footer />
</Layout>

<script>
	import '../../lib/landing';
</script>
