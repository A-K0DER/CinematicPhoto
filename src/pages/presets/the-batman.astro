---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import DropZone from '../../components/DropZone.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import RelatedPresets from '../../components/RelatedPresets.astro';
import MovieFaq from '../../components/MovieFaq.astro';
import { getPreset } from '../../lib/presets';

const preset = getPreset('the-batman');
const path = '/presets/the-batman/';

const title = 'The Batman Photo Filter & Editor | Free Cinematic Tool';
const description =
	"Use this free The Batman photo filter and photo editor to grade your photo with the film's crimson-black noir, rain-soaked Gotham look, instantly in your browser — no account needed.";
const keywords =
	'the batman photo filter, the batman photo editor, the batman editor, the batman color grade, gotham noir photo filter';

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	name: title,
	description,
	url: `https://cinematicphoto.com${path}`,
	isPartOf: { '@type': 'WebSite', name: 'Cinematic Photo', url: 'https://cinematicphoto.com' },
};

const faqs = [
	{
		q: 'Is this an official The Batman photo filter?',
		a: "No. This preset is inspired by the visual aesthetic of The Batman's cinematography, it isn't an official filter licensed by or affiliated with Warner Bros., DC, or the film's creators. It's an independent color grade built to recreate the look, not a branded product.",
	},
	{
		q: 'Is there a dedicated The Batman photo editor?',
		a: "This page is that dedicated editor — the The Batman grade loads pre-selected in the drop zone above, so you can drop a photo and immediately adjust its vignette, grain, and glow without hunting through the full 60-preset library first.",
	},
	{
		q: 'Why does The Batman preset lean crimson instead of the cooler steel-blue of The Dark Knight?',
		a: "Cinematographer Greig Fraser built this film's Gotham around near-constant rain and red practical light, the Bat-signal, emergency flares, neon signage, giving the grade a crimson-black noir cast rather than The Dark Knight's colder, more restrained steel-and-olive palette.",
	},
	{
		q: 'How is The Batman different from the Dark Knight preset?',
		a: "They're both Batman-universe grades but built around different films' cinematography. The Batman leans much darker overall, with a heavier vignette and a crimson-black color split rather than steel-and-olive. The Dark Knight keeps more ambient brightness and a cooler, more neutral cold tone throughout.",
	},
	{
		q: 'My photo looks almost too dark after applying The Batman grade. Is that intentional?',
		a: "Yes. The preset pulls brightness down more aggressively than most grades in this tool and pairs it with one of the heaviest vignette defaults, echoing the film's extremely low-key, underexposed noir lighting. If it feels too dark, back off the vignette slider in the editor afterward.",
	},
	{
		q: 'Does The Batman preset work on daytime photos?',
		a: "It's built around night, rain, and red practical light, so it shows off most on shots with some existing shadow depth or artificial light. Bright daylight photos still get the contrast push and crimson-black split, but the effect reads more subtly without dark ambient light to work with.",
	},
	{
		q: 'What kind of photos look best with a The Batman-style color grade?',
		a: 'Rain-soaked streets, red or neon signage, and night cityscapes are the strongest fits, since they give the grade\'s crimson highlights and crushed shadows real texture. Moody, low-key portraits under a single red or warm light source also hold up especially well.',
	},
];
---

<Layout {title} {description} {keywords} {path} structuredData={structuredData}>
	<Navbar variant="landing" />
	<main>
		<Breadcrumbs
			items={[
				{ label: 'Home', href: '/' },
				{ label: 'All Presets', href: '/presets/' },
				{ label: 'The Batman' },
			]}
		/>

		<DropZone presetId={preset.id} showHeading={false} showFooterLinks={false} />

		<section class="mx-auto flex w-full max-w-3xl flex-col items-center px-4 pb-4 text-center sm:px-6">
			<span class="mb-4 font-mono text-xs tracking-wide text-mute">MOVIE-INSPIRED PRESET</span>
			<h1 class="font-sans text-4xl font-semibold tracking-[-0.03em] text-ink sm:text-5xl">
				The Batman photo filter: crimson-black noir, rain-soaked Gotham.
			</h1>
			<p class="mt-5 max-w-xl text-base leading-7 text-body">
				A free The Batman photo editor and color grading preset inspired by the visual aesthetic
				of Matt Reeves' The Batman, built for photographers who want that dark, rain-soaked,
				crimson-tinted Gotham look without touching a curves panel.
			</p>
		</section>

		<section class="mx-auto w-full max-w-3xl px-4 py-14 sm:px-6">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">THE AESTHETIC</span>
			<h2 class="font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">
				A detective story soaked in rain and red light
			</h2>
			<div class="mt-6 flex flex-col gap-5 text-base leading-7 text-body">
				<p>
					Cinematographer Greig Fraser built The Batman's Gotham as a neo-noir detective story
					first, superhero film second, drawing heavily on 1970s crime cinema. Rain falls in nearly
					every exterior, and red practical light, the Bat-signal, flares, sirens, neon, becomes the
					film's dominant accent color against a city otherwise drained of warmth.
				</p>
				<p>
					Exposure runs deliberately low throughout, letting shadows swallow most of the frame so
					that red and amber light sources become the only relief. It's an even darker, more
					oppressive palette than earlier Batman films, built around near-silhouette rather than
					legible detail in every shadow.
				</p>
			</div>
		</section>

		<section class="mx-auto w-full max-w-3xl px-4 pb-14 sm:px-6">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">BEFORE / AFTER</span>
			<h2 class="mb-6 font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">
				See the grade applied
			</h2>
			<BeforeAfter preset={preset} />
		</section>

		<section class="mx-auto w-full max-w-3xl px-4 pb-14 sm:px-6">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">THE COLOR SCIENCE</span>
			<h2 class="font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">
				How The Batman color grade actually works
			</h2>
			<div class="mt-6 flex flex-col gap-5 text-base leading-7 text-body">
				<p>
					The base adjustment pushes contrast hard while pulling brightness down significantly, one
					of the darkest defaults in this tool's library, to establish the film's near-silhouette
					exposure before any color is added. A deep crimson-black overlay then sits across the
					frame in overlay blend mode, tinting shadows and midtones toward red rather than the
					cooler steel of a typical Gotham grade.
				</p>
				<p>
					Vignette runs among the heaviest in the tool, closing the frame in tightly around the
					subject to match the film's claustrophobic framing, while grain stays moderate and glow
					restrained, keeping red light sources contained rather than blooming softly the way they
					do in a hazier grade like Blade Runner 2049's.
				</p>
			</div>
		</section>

		<section class="mx-auto w-full max-w-3xl px-4 pb-14 sm:px-6">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">BEST PHOTOS FOR THIS PRESET</span>
			<h2 class="font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">
				What to shoot it on
			</h2>
			<ul class="mt-6 flex flex-col gap-4 text-base leading-7 text-body">
				<li class="flex gap-3">
					<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-mute"></span>
					<span><span class="font-medium text-ink">Rain-soaked streets and reflections.</span> Wet pavement picks up the grade's crimson highlights as reflected light, deepening the effect.</span>
				</li>
				<li class="flex gap-3">
					<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-mute"></span>
					<span><span class="font-medium text-ink">Red or neon signage at night.</span> A visible red or warm light source is exactly what this grade's color split is built around.</span>
				</li>
				<li class="flex gap-3">
					<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-mute"></span>
					<span><span class="font-medium text-ink">Low-key, single-source portraits.</span> Hard, dim lighting with one dominant source matches the film's near-silhouette character lighting.</span>
				</li>
			</ul>
		</section>

		<RelatedPresets
			heading="More movie-inspired grades"
			items={[
				{ presetId: 'dark-knight', href: '/presets/the-dark-knight/' },
				{ presetId: 'joker', href: '/presets/joker/' },
				{ presetId: 'watchmen', href: '/?preset=watchmen' },
				{ presetId: 'deadpool', href: '/?preset=deadpool' },
				{ presetId: 'spider-man', href: '/?preset=spider-man' },
			]}
		/>

		<MovieFaq
			eyebrow="THE BATMAN FAQ"
			heading="Common questions about the The Batman photo filter"
			faqs={faqs}
		/>

		<section class="mx-auto w-full max-w-3xl px-4 py-14 text-center sm:px-6">
			<p class="text-base leading-7 text-body">
				Prefer a different film's look? Browse the <a href="/presets/" class="text-ink underline decoration-hairline-strong underline-offset-2 hover:decoration-ink">full library of 60 presets</a>,
				see more <a href="/looks/dark-and-moody/" class="text-ink underline decoration-hairline-strong underline-offset-2 hover:decoration-ink">dark and moody presets</a>,
				or head to the <a href="/" class="text-ink underline decoration-hairline-strong underline-offset-2 hover:decoration-ink">homepage</a> to start with a blank slate.
			</p>
		</section>
	</main>
	<Footer />
</Layout>

<script>
	import '../../lib/landing';
</script>
