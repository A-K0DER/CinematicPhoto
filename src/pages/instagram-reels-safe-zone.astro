---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SafeZoneTool from '../components/SafeZoneTool.astro';
import MovieFaq from '../components/MovieFaq.astro';

const path = '/instagram-reels-safe-zone/';
const title = 'Instagram Safe Zone Checker | Reels, Post & Stories UI Overlay Tool';
const description =
	"Drop a photo onto Instagram's frame and see exactly where the app's own caption, username, and UI elements will sit on top of it, for Reels, feed Posts, and Stories.";
const keywords =
	'instagram safe zone, reels safe zone, instagram stories safe zone, instagram post safe zone, reels safe zone template, instagram ui overlay, reels 1080x1920 safe zone, instagram video safe zone';

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'WebApplication',
	name: 'Instagram Safe Zone Checker',
	url: `https://cinematicphoto.com${path}`,
	description,
	applicationCategory: 'DesignApplication',
	operatingSystem: 'Any (runs in browser)',
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
	isAccessibleForFree: true,
};

const howToStructuredData = {
	'@context': 'https://schema.org',
	'@type': 'HowTo',
	name: "How to check Instagram's safe zone on a photo",
	description: "Overlay Reels', Stories', or feed Post's UI and crop bands on a photo before posting.",
	step: [
		{
			'@type': 'HowToStep',
			name: 'Pick a format',
			text: 'Switch between Reels, Post, and Stories above the preview — each uses its own frame and safe-zone bands.',
		},
		{
			'@type': 'HowToStep',
			name: 'Upload a photo',
			text: 'Drop a photo or thumbnail onto the tool, paste it, or click to upload a JPG, PNG, or WEBP file.',
		},
		{
			'@type': 'HowToStep',
			name: 'Reposition inside the frame',
			text: "Drag inside the frame to reposition the photo within the selected format's export crop.",
		},
		{
			'@type': 'HowToStep',
			name: "Check the UI overlay",
			text: "Review the dimmed bands showing that format's UI or grid-crop safe zones, drawn to scale on the photo.",
		},
		{
			'@type': 'HowToStep',
			name: 'Save a reference image',
			text: 'Adjust the overlay opacity if needed, then save the cropped reference image.',
		},
	],
};

const faqs = [
	{
		q: "What is Instagram's safe zone?",
		a: "It's the part of the frame that gets covered or cropped once a photo is actually posted. Reels and Stories lay their own interface, captions, usernames, a reply field, engagement icons, on top of a 9:16 video frame. Feed Posts don't get a UI overlay, but a 4:5 post gets center-cropped to a square in the profile grid, so its top and bottom edges are hidden there. Anything important, a face, a subtitle, a product, placed in those zones gets partly or fully hidden depending on where someone sees it. Reels, Stories, and Post each reserve different space, use the tabs above to check the one you're actually posting to.",
	},
	{
		q: 'Is this safe zone measurement exact?',
		a: "It's a close approximation based on Instagram's published creator and ads specs, not a pixel-perfect measurement pulled from the live app. Instagram tweaks its UI over time, so treat this as a composition check, not a guarantee.",
	},
	{
		q: 'Does this tool upload my photo anywhere?',
		a: 'No. The image is drawn straight into an on-page canvas and never leaves your browser.',
	},
	{
		q: 'Can I check TikTok too?',
		a: "Yes, TikTok reserves similar but not identical space to Reels and Stories. Use the dedicated TikTok safe zone checker, or the combined checker that overlays TikTok and Reels at once for a side-by-side comparison.",
	},
	{
		q: 'What size is the Reels safe zone?',
		a: "At the standard 1080x1920 export, the bottom caption/username/audio band runs roughly 24% up from the base (about 461px), and the right-hand icon column eats roughly the last 12% of width (about 130px). Switch to the Reels tab above to see both bands drawn to scale on your own photo, plus the exact pixel and percent figures.",
	},
	{
		q: "What's Reels' ideal video size and aspect ratio?",
		a: "1080x1920 pixels at a 9:16 aspect ratio is Instagram's standard export size for Reels. This tool's Reels tab matches that resolution, so the safe-zone measurements line up directly with whatever you export from your camera or editor.",
	},
	{
		q: 'Does the Reels safe zone apply to Reels cover photos too?',
		a: "Yes. A Reels cover image, the still frame or photo shown before someone taps play, sits inside the same 9:16 frame and gets the same caption, username, audio, and icon overlay as the video itself, so the same safe zone applies.",
	},
	{
		q: 'What is the Instagram Stories safe zone?',
		a: "At the standard 1080x1920 export, Stories reserves roughly the top 12% (about 230px) for the profile picture, username, timestamp, and close button, and roughly the bottom 12% (about 230px) for the reply field and share row. Switch to the Stories tab above to see both bands drawn to scale on your own photo.",
	},
	{
		q: "What's Stories' ideal size and aspect ratio?",
		a: "1080x1920 pixels at 9:16, the same export size as Reels. The UI bands differ, though, Stories has no side icon column, so don't reuse a Reels-checked composition for Stories without checking the top and bottom bands too.",
	},
	{
		q: 'Does the Stories safe zone apply to Highlight covers too?',
		a: "Partly. A Highlight cover is a small circular crop taken from the center of your Story image, so it automatically discards the top and bottom UI bands. Keeping your subject centered per the Stories safe zone above generally keeps it inside the Highlight cover too, but text near the edges of that center square can still get trimmed by the circular mask, so keep any text closer to the middle if it also needs to survive as a Highlight cover.",
	},
	{
		q: 'What is the Instagram Post safe zone?',
		a: "A 4:5 feed Post (1080x1350) gets center-cropped to a 1:1 square in the profile grid, cutting roughly 10% (about 135px) off the top and another 10% off the bottom. There's no app UI drawn on top of a Post the way there is on Reels or Stories, so this is really a \"what survives the grid crop\" check, not a UI-overlap one.",
	},
	{
		q: "What's Post's ideal size and aspect ratio?",
		a: "1080x1350 pixels at a 4:5 aspect ratio is Instagram's recommended portrait size for feed Posts, it shows more of the photo in-feed than a square 1:1 crop does. The profile grid still displays a square thumbnail though, which is what the Post safe zone above accounts for.",
	},
	{
		q: 'Does the Post safe zone apply to carousel (multi-photo) posts too?',
		a: "Yes, but only for the first slide. Every slide in a carousel is exported at the same 4:5 frame, but Instagram only ever generates the profile grid thumbnail from the first slide's center-cropped square. Slides beyond the first are only ever seen at full 4:5 size when someone swipes through, so their top and bottom edges are never trimmed by the grid crop.",
	},
	{
		q: 'Where should I put a face, subtitle, or logo to keep it visible?',
		a: "For Reels, the center third of the frame, roughly the middle of the width and the area between the top bar and bottom caption band, stays clear across devices. For Stories, keep it centered between the top profile bar and bottom reply row. For a Post, keep the subject within the middle square so it still reads once the profile grid crops the top and bottom.",
	},
];
---

<Layout {title} {description} {keywords} {path} structuredData={structuredData}>
	<Navbar variant="landing" />
	<main>
		<Breadcrumbs
			items={[
				{ label: 'Home', href: '/' },
				{ label: 'Tools', href: '/tools/safe-zones/' },
				{ label: 'Instagram Safe Zone' },
			]}
		/>

		<section class="mx-auto flex w-full max-w-3xl flex-col items-center px-4 pb-4 text-center sm:px-6">
			<span class="mb-4 font-mono text-xs tracking-wide text-mute">FREE TOOL</span>
			<h1 class="font-sans text-4xl font-semibold tracking-[-0.03em] text-ink sm:text-5xl">
				Instagram safe zone checker
			</h1>
			<p class="mt-5 max-w-xl text-base leading-7 text-body">
				Drop a photo onto Instagram's frame to see where the app's own UI will sit on top of it,
				before you post. Switch between Reels, feed Posts, and Stories above the preview.
			</p>
		</section>

		<SafeZoneTool platform={['reels', 'post', 'stories']} />

		<section class="mx-auto w-full max-w-3xl px-4 py-14 sm:px-6">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">WHY IT MATTERS</span>
			<h2 class="font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">
				Composition that survives Instagram's own UI and crops
			</h2>
			<div class="mt-6 flex flex-col gap-5 text-base leading-7 text-body">
				<p>
					A frame that looks perfectly composed in a raw export can still lose its subject once
					Instagram lays its own interface on top, or crops it into a different shape. Reels and
					Stories both draw a caption, username, and engagement or reply UI over a 9:16 video frame;
					a 4:5 feed Post instead gets center-cropped to a square in the profile grid. Checking
					against the right safe zone before posting means a face, a subtitle, or a key product
					detail doesn't end up hidden or cut off.
				</p>
				<p>
					Reels reserves a thin top bar and a bottom caption/username/audio band plus a right-hand
					engagement column; Stories reserves a top profile bar and a bottom reply row; a Post loses
					roughly 10% off its top and bottom edges in the grid view. This tool switches its overlay
					to match whichever format you're checking, drawn straight onto your photo so you can see
					the effect on your actual composition.
				</p>
			</div>
		</section>

		<section class="mx-auto w-full max-w-3xl px-4 pb-14 sm:px-6">
			<span class="mb-4 block font-mono text-xs tracking-wide text-mute">GO DEEPER</span>
			<h2 class="font-sans text-2xl font-semibold tracking-[-0.02em] text-ink sm:text-3xl">
				More tools for creators
			</h2>
			<div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
				<a href="/tiktok-safe-zone/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">TikTok safe zone checker</span>
					<span class="mt-1 block font-mono text-xs text-mute">The same check, tuned to TikTok's UI</span>
				</a>
				<a href="/tools/safe-zones/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">Compare TikTok vs. Reels</span>
					<span class="mt-1 block font-mono text-xs text-mute">Toggle both platforms' overlays at once</span>
				</a>
				<a href="/for/instagram/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">Cinematic Instagram editor</span>
					<span class="mt-1 block font-mono text-xs text-mute">Presets plus 1:1 / 4:5 / 9:16 export crops</span>
				</a>
				<a href="/presets/" class="rounded-md border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong">
					<span class="block font-sans text-sm font-medium text-ink">Browse all 60 presets</span>
					<span class="mt-1 block font-mono text-xs text-mute">Every color grade, organized by genre</span>
				</a>
			</div>
		</section>

		<MovieFaq eyebrow="FAQ" heading="Common questions about Instagram's safe zones" faqs={faqs} />

		<script type="application/ld+json" set:html={JSON.stringify(howToStructuredData)} />
	</main>
	<Footer />
</Layout>
