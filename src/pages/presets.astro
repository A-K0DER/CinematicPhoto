---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { GENRES, PRESETS, getPresetsByGenre, getOverlayBackground } from '../lib/presets';
import { MOVIE_PRESET_PAGES } from '../data/moviePresetPages';

const title = `All ${PRESETS.length} Movie & TV Presets | Cinematic Photo Editor`;
const description = `Browse all ${PRESETS.length} movie- and TV-inspired cinematic color grading presets across ${GENRES.length} genres, from Thriller to TV Shows. Pick one and apply it in the free online editor.`;

const presetListStructuredData = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: 'Cinematic Photo Editor movie color grading presets',
	numberOfItems: PRESETS.length,
	itemListElement: PRESETS.map((preset, index) => ({
		'@type': 'ListItem',
		position: index + 1,
		name: `${preset.name} (${preset.genre}) — ${preset.tagline}`,
	})),
};
---

<Layout title={title} description={description} path="/presets/">
	<Navbar />
	<main class="mx-auto max-w-5xl px-4 py-20 sm:px-6">
		<span class="mb-4 block font-mono text-xs tracking-wide text-mute">ALL PRESETS</span>
		<h1 class="max-w-2xl font-sans text-3xl font-semibold tracking-[-0.03em] text-ink sm:text-4xl">
			{PRESETS.length} movie- and TV-inspired color grades, organized by genre
		</h1>
		<p class="mt-4 max-w-xl text-base leading-7 text-body">
			Pick a preset below to jump into the editor with it pre-selected. Drop or upload a photo
			once you're there to see the grade applied. Presets span {GENRES.length} genres: {GENRES.join(', ')}.
		</p>

		<section class="mt-10 rounded-lg border border-hairline bg-canvas-soft p-5">
			<span class="mb-3 block font-mono text-[11px] font-medium tracking-wide text-mute uppercase">
				Or browse by look
			</span>
			<div class="grid grid-cols-1 gap-2.5 sm:grid-cols-2 lg:grid-cols-4">
				<a href="/looks/dark-and-moody/" class="rounded-md border border-hairline bg-canvas p-3 text-sm font-medium text-ink transition-colors hover:border-hairline-strong">
					Dark &amp; Moody
				</a>
				<a href="/looks/vintage-35mm-film/" class="rounded-md border border-hairline bg-canvas p-3 text-sm font-medium text-ink transition-colors hover:border-hairline-strong">
					Vintage 35mm Film
				</a>
				<a href="/for/portraits/" class="rounded-md border border-hairline bg-canvas p-3 text-sm font-medium text-ink transition-colors hover:border-hairline-strong">
					For Portraits
				</a>
				<a href="/guides/how-to-make-photos-look-cinematic/" class="rounded-md border border-hairline bg-canvas p-3 text-sm font-medium text-ink transition-colors hover:border-hairline-strong">
					How-To Guides
				</a>
			</div>
		</section>

		{
			GENRES.map((genre) => (
				<section class="mt-14 first:mt-12">
					<h2 class="mb-4 font-mono text-[11px] font-medium tracking-wide text-mute uppercase">
						{genre}
					</h2>
					<div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
						{getPresetsByGenre(genre).map((preset) => (
							<a
								href={MOVIE_PRESET_PAGES[preset.id] ? `/presets/${MOVIE_PRESET_PAGES[preset.id].slug}/` : `/?preset=${preset.id}`}
								class="group flex flex-col items-start gap-2 rounded-md border border-hairline bg-canvas p-2.5 text-left transition-colors hover:border-hairline-strong"
							>
								<span class="relative block h-14 w-full overflow-hidden rounded-sm">
									<img
										loading="lazy"
										decoding="async"
										alt={preset.name}
										src={preset.image}
										style={`filter: ${preset.filter};`}
										class="absolute inset-0 h-full w-full object-cover"
									/>
									<span
										class="absolute inset-0"
										style={`background: ${getOverlayBackground(preset.overlay)}; opacity: ${preset.overlay.opacity}; mix-blend-mode: ${preset.overlay.blend};`}
									/>
								</span>
								<span class="font-sans text-xs font-medium text-ink">{preset.name}</span>
								<span class="font-mono text-[10px] leading-tight text-mute">{preset.tagline}</span>
							</a>
						))}
					</div>
				</section>
			))
		}
	</main>
	<Footer />

	<script type="application/ld+json" set:html={JSON.stringify(presetListStructuredData)} />
</Layout>
