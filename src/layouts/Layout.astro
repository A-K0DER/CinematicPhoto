---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	keywords?: string;
	path?: string;
	structuredData?: object;
	noindex?: boolean;
}

const {
	title = 'Cinematic Photo Editor | Free Online Movie-Style Color Grading',
	description = "Turn any photo into a movie-style still with one click. 60 free cinematic color grading presets inspired by iconic films and TV shows. 100% browser-based, no uploads.",
	keywords = "cinematic photo editor, movie color grade presets, film look photo filter, thriller photo filter, crime movie color grade, sci-fi photo filter, war movie photo effect, fantasy adventure photo filter, action movie color grade, superhero photo filter, The Shawshank Redemption filter, The Dark Knight color grade, Inception photo filter, Fight Club color grade, Pulp Fiction filter, Gladiator color grade, Blade Runner 2049 filter, Oppenheimer photo filter, teal and orange color grade, film grain online, cinematic letterbox, movie LUT online",
	path = '/',
	structuredData,
	noindex = false,
} = Astro.props;

const siteUrl = 'https://cinematicphoto.com';
const canonicalUrl = new URL(path, siteUrl).toString();
const ogImageUrl = new URL('/og-image.png', siteUrl).toString();

const defaultStructuredData = {
	'@context': 'https://schema.org',
	'@type': 'WebApplication',
	name: 'Cinematic Photo Editor',
	alternateName: 'CinematicPhoto',
	url: siteUrl,
	description,
	applicationCategory: 'PhotoEditingApplication',
	operatingSystem: 'Any (runs in browser)',
	browserRequirements: 'Requires a modern browser with Canvas support',
	offers: {
		'@type': 'Offer',
		price: '0',
		priceCurrency: 'USD',
	},
	featureList: [
		'60 movie- and TV-inspired color grading presets across 9 genres',
		'The Shawshank Redemption warm 35mm grade',
		'The Dark Knight cold steel grade',
		'Inception cool steel-blue dream grade',
		'Fight Club sickly 90s grade',
		'Pulp Fiction pulpy amber-red grade',
		'Gladiator bleached golden-arena grade',
		'Adjustable film grain',
		'Vignette and glow / halation controls',
		'Anamorphic 2.39:1 letterbox bars',
		'Film stock metadata stamp',
		'Client-side processing, no uploads',
	],
	isAccessibleForFree: true,
};

const jsonLd = structuredData ?? defaultStructuredData;
---

<!doctype html>
<html lang="en">
	<head>
		<!-- Google tag (gtag.js) -->
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-Y6GL9YP4WF"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag('js', new Date());

			gtag('config', 'G-Y6GL9YP4WF');
		</script>

		<script is:inline>
			(function () {
				var stored = localStorage.getItem('theme');
				var theme =
					stored === 'light' || stored === 'dark'
						? stored
						: window.matchMedia('(prefers-color-scheme: light)').matches
							? 'light'
							: 'dark';
				document.documentElement.dataset.theme = theme;
			})();
		</script>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
		<meta name="author" content="Cinematic Photo" />

		<!-- Open Graph -->
		<meta property="og:site_name" content="Cinematic Photo" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Cinematic Photo Editor: movie-style color grading in your browser" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content="Cinematic Photo Editor: movie-style color grading in your browser" />

		<meta id="theme-color-meta" name="theme-color" content="#09090b" />

		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body class="min-h-screen bg-canvas text-ink antialiased">
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
	}
</style>
